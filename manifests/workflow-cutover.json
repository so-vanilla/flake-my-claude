  "cutover_conflicts": [
    {
      "path": "~/.codex/AGENTS.md",
      "current_type": "regular-file",
      "required_action": "User removes the reviewed old regular file immediately before activation."
    },
    {
      "path": "~/.codex/hooks.json",
      "current_type": "regular-file",
      "required_action": "User removes the reviewed old regular file immediately before activation."
    },
    {
      "path": "~/.claude/session-status.sh",
      "current_type": "regular-file",
      "required_action": "User removes or backs up the reviewed old regular file immediately before activation."
    }
  ],
  "pre_activation_checks": [
    "Back up or remove the three reviewed unmanaged regular-file conflicts; activation must stop rather than force-overwrite if one remains.",
    "Keep ~/.codex/config.toml unmanaged, but set model = gpt-5.6-sol and model_reasoning_effort = medium through the app or a reviewed direct edit.",
    "Review and trust the new ~/.codex/hooks.json definition after activation before claiming hook enforcement.",
    "Keep the previous Home Manager generation and reviewed regular-file backups as the rollback path."
  ],
  "post_activation_cleanup": {
    "inventory_exact_paths": [
      "~/.claude/commands",
      "~/.claude/skills/plan-task",
      "~/.claude/skills/self-verification-loop"
    ],
    "remove_only_if_empty_and_separately_authorized": true,
    "completion_checks": [
      "The live Codex configured default is model = gpt-5.6-sol and model_reasoning_effort = medium; an xhigh value keeps cutover incomplete.",
      "All 17 legacy command files are absent.",
      "All 10 legacy Claude agent files are absent while the six new profiles are present.",
      "The plan-task and self-verification-loop directories contain no SKILL.md or other residual file.",
      "Each harness exposes exactly the approved 30 shared Skill names.",
      "Excluded product-managed Codex and Claude state remains untouched."
    ]
  },
  "excluded_product_state": [
    "~/.codex/skills/.system",
    "~/.codex/plugins/cache",
    "~/.codex/config.toml",
    "~/.claude/plugins",
    "~/.claude/cache",
    "~/.claude/projects",
    "~/.claude/sessions"
  ]
