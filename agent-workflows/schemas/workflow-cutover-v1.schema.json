{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "workflow-cutover-v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema", "expected_head", "lease_ref", "candidate_ref", "issued_lineage_inventory_ref", "old_contract_version", "new_contract_version", "issuance_watermark", "outstanding_old_package_ids", "old_lineage_bindings", "selection_rule", "cutover_digest"],
  "properties": {
    "schema": {"const": "workflow-cutover/v1"}, "expected_head": {"type": "object", "additionalProperties": false, "required": ["revision", "transaction_digest"], "properties": {"revision": {"type": "integer", "minimum": 0}, "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "lease_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "candidate_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "issued_lineage_inventory_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "old_contract_version": {"type": "string", "minLength": 1}, "new_contract_version": {"type": "string", "minLength": 1}, "issuance_watermark": {"type": "integer", "minimum": 0}, "outstanding_old_package_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "old_lineage_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["root_package_id", "package_ids", "terminal_refs", "contract_version"], "properties": {"root_package_id": {"type": "string", "minLength": 1}, "package_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "terminal_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}, "contract_version": {"type": "string", "minLength": 1}}}},
    "selection_rule": {"type": "object", "additionalProperties": false, "required": ["at_or_below_watermark", "existing_descendants", "later_new_roots"], "properties": {"at_or_below_watermark": {"type": "string", "minLength": 1}, "existing_descendants": {"type": "string", "minLength": 1}, "later_new_roots": {"type": "string", "minLength": 1}}}, "cutover_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
