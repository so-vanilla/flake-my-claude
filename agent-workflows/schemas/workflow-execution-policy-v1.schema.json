{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-execution-policy-v1.schema.json",
  "title": "Digest-bound required-only feedback policy for normal Group E execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "version",
    "review_join",
    "validation",
    "resolution",
    "convergence",
    "budget_terminal"
  ],
  "properties": {
    "schema": {"const": "workflow-execution-policy/v1"},
    "policy_id": {"const": "required-only-feedback"},
    "version": {"const": "v1"},
    "review_join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectors", "join", "next_selector"],
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["group.E.E4", "group.E.E5"]}
        },
        "join": {"const": "exact-terminal"},
        "next_selector": {"const": "group.E.E6"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "routes"],
      "properties": {
        "selector": {"const": "group.E.E6"},
        "routes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disposition", "next_selector", "terminal_status", "pass"],
            "properties": {
              "disposition": {"enum": ["no-open-required", "required", "needs-user-or-unresolved"]},
              "next_selector": {"type": ["string", "null"]},
              "terminal_status": {"type": ["string", "null"]},
              "pass": {"type": "boolean"}
            }
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "requires_disposition", "fresh_rereview", "return_to_selector"],
      "properties": {
        "selector": {"const": "group.E.E7"},
        "requires_disposition": {"const": "required"},
        "fresh_rereview": {"const": true},
        "return_to_selector": {"const": "group.E.E6"}
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_selector", "next_selector", "new_candidate_selector", "accepted_terminal", "blocked_by_open"],
      "properties": {
        "entry_selector": {"const": "group.E.E8"},
        "next_selector": {"const": "group.E.E9"},
        "new_candidate_selector": {"const": "group.E.E6"},
        "accepted_terminal": {"const": "accepted"},
        "blocked_by_open": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["required", "needs-user", "unresolved"]}
        }
      }
    },
    "budget_terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "non_dispatch", "pass"],
      "properties": {
        "status": {"const": "stopped-budget"},
        "non_dispatch": {"const": true},
        "pass": {"const": false}
      }
    }
  }
}
