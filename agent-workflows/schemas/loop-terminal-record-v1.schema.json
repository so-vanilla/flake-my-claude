{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-terminal-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "terminal_id", "identity", "outcome", "reason",
    "candidate_ref", "requirements", "reviews", "evidence", "open_items",
    "resume_ref", "non_authorizing"
  ],
  "properties": {
    "schema": {"const": "loop-terminal-record/v1"},
    "terminal_id": {"$ref": "#/$defs/id"},
    "identity": {"$ref": "loop-work-identity-v1.schema.json"},
    "outcome": {"enum": ["completed", "needs-input", "stalled", "iteration-limit", "execution-failed", "recovery-required"]},
    "reason": {"type": "string", "minLength": 1},
    "candidate_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "requirements": {"type": "array", "items": {"$ref": "loop-requirement-assessment-v1.schema.json"}},
    "reviews": {"type": "array", "items": {"$ref": "loop-review-assessment-v1.schema.json"}},
    "evidence": {"type": "array", "items": {"$ref": "loop-evidence-record-v1.schema.json"}},
    "open_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resume_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "non_authorizing": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "anyOf": [{"required": ["id"]}, {"required": ["path"]}]
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {"const": "completed"},
        "candidate_ref": {"$ref": "#/$defs/ref"},
        "requirements": {"minItems": 1},
        "reviews": {"minItems": 1},
        "evidence": {"minItems": 1},
        "open_items": {"maxItems": 0},
        "resume_ref": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"enum": ["needs-input", "stalled", "iteration-limit", "execution-failed", "recovery-required"]},
        "open_items": {"minItems": 1}
      }
    }
  ]
}
