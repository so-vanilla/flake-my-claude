{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurement-observation-v1.schema.json",
  "title": "Measured value or explicit unavailable measurement observation",
  "oneOf": [{"$ref": "#/$defs/available"}, {"$ref": "#/$defs/unavailable"}],
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/).+"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "window": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "available": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "observation_id", "status", "value", "unit", "condition", "window", "source_ref"],
      "properties": {"schema": {"const": "measurement-observation/v1"}, "observation_id": {"type": "string", "minLength": 1}, "status": {"const": "available"}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "condition": {"type": "string", "minLength": 1}, "window": {"$ref": "#/$defs/window"}, "source_ref": {"$ref": "#/$defs/ref"}}
    },
    "unavailable_reason": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"enum": ["stale", "access-denied", "side-effect-required", "incomparable"]}}},
        {"type": "object", "additionalProperties": false, "required": ["code", "decision_ref"], "properties": {"code": {"const": "not-measured"}, "decision_ref": {"$ref": "#/$defs/ref"}}}
      ]
    },
    "unavailable": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "observation_id", "status", "value", "reason"],
      "properties": {"schema": {"const": "measurement-observation/v1"}, "observation_id": {"type": "string", "minLength": 1}, "status": {"const": "unavailable"}, "value": {"type": "null"}, "reason": {"$ref": "#/$defs/unavailable_reason"}}
    }
  }
}
