{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-iteration-event-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "command_id", "identity", "kind", "status", "attempt", "predecessor_ref", "result_ref"],
  "properties": {
    "schema": {"const": "loop-iteration-event/v1"},
    "event_id": {"$ref": "#/$defs/id"},
    "command_id": {"$ref": "#/$defs/id"},
    "identity": {"$ref": "loop-work-identity-v1.schema.json"},
    "kind": {"enum": ["initial", "improvement", "integration-return", "technical-retry"]},
    "status": {"enum": ["reserved", "running", "evaluated", "execution-unknown"]},
    "attempt": {"type": "integer", "minimum": 0},
    "predecessor_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "result_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["digest"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}},
      "anyOf": [{"required": ["id"]}, {"required": ["path"]}]
    }
  }
}
