{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-group-v1.schema.json",
  "oneOf": [{"$ref": "#/$defs/candidate"}, {"$ref": "#/$defs/refusal"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "qualified_id": {"enum": ["group.E.E1", "group.E.E2", "group.E.E3", "group.E.E4", "group.E.E5", "group.E.E6", "group.E.E7", "group.E.E8", "group.E.E9", "group.E.E10"]},
    "candidate_base": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "qualified_id", "loop_level", "expected_head", "authority_ref", "non_mutating", "candidate_digest", "stage", "status"],
      "properties": {
        "schema": {"const": "execution-group-candidate/v1"}, "qualified_id": {"$ref": "#/$defs/qualified_id"}, "loop_level": {"enum": ["artifact", "section", "workflow"]}, "expected_head": {"type": "object"}, "authority_ref": {"type": "object"}, "non_mutating": {"const": true}, "candidate_digest": {"$ref": "#/$defs/digest"}, "stage": {"type": "string"}, "status": {"type": "string"},
        "receipt": {"type": "object"}, "package": {"type": "object"}, "artifact_candidate": {"type": "object"}, "recovery": {"type": "object"}, "report": {"type": "object"}, "report_digest": {"$ref": "#/$defs/digest"}, "findings": {"type": "array"}, "validation": {"type": "object"}, "next": {"type": "string"}, "worker_self_close": {"type": "boolean"}, "orchestrator_transition": {"type": "object"}, "head_advanced": {"type": "boolean"}, "aggregate": {"type": "object"}, "finalization": {"type": "object"}, "new_findings_route": {"type": "string"}, "external_authority": {"type": "boolean"}, "model_route": {"type": "object"}
      }
    },
    "candidate": {"allOf": [
      {"$ref": "#/$defs/candidate_base"},
      {"oneOf": [
        {"required": ["receipt"], "properties": {"qualified_id": {"const": "group.E.E1"}, "stage": {"const": "E1"}, "status": {"const": "ready"}}},
        {"required": ["package"], "properties": {"qualified_id": {"const": "group.E.E2"}, "stage": {"const": "E2"}, "status": {"const": "issued"}}},
        {"required": ["artifact_candidate", "recovery"], "properties": {"qualified_id": {"const": "group.E.E3"}, "stage": {"const": "E3"}, "status": {"const": "submitted"}}},
        {"required": ["report", "report_digest", "findings"], "properties": {"qualified_id": {"const": "group.E.E4"}, "stage": {"const": "E4"}, "status": {"const": "reviewed"}}},
        {"required": ["report", "report_digest", "findings"], "properties": {"qualified_id": {"const": "group.E.E5"}, "stage": {"const": "E5"}, "status": {"const": "reviewed"}}},
        {"required": ["validation", "next"], "properties": {"qualified_id": {"const": "group.E.E6"}, "stage": {"const": "E6"}, "status": {"const": "validated"}}},
        {"required": ["next", "worker_self_close", "orchestrator_transition"], "properties": {"qualified_id": {"const": "group.E.E7"}, "stage": {"const": "E7"}, "status": {"enum": ["rereview-required", "stopped-budget"]}}},
        {"required": ["head_advanced", "aggregate", "finalization"], "properties": {"qualified_id": {"const": "group.E.E8"}, "stage": {"const": "E8"}, "status": {"const": "converged"}}},
        {"required": ["new_findings_route"], "properties": {"qualified_id": {"const": "group.E.E9"}, "stage": {"const": "E9"}, "status": {"const": "verified"}}},
        {"required": ["external_authority", "model_route"], "properties": {"qualified_id": {"const": "group.E.E10"}, "stage": {"const": "E10"}, "status": {"const": "advisory-options"}}}
      ]}
    ]},
    "refusal": {"type": "object", "additionalProperties": false, "required": ["schema", "qualified_id", "reason", "non_mutating"], "properties": {"schema": {"const": "execution-group-refusal/v1"}, "qualified_id": {"$ref": "#/$defs/qualified_id"}, "reason": {"type": "string", "minLength": 1}, "non_mutating": {"const": true}}}
  }
}
