{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-work-identity-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "work_lineage_id", "logical_task_id", "phase", "scope_revision", "requirements_digest", "predecessor_ref"],
  "properties": {
    "schema": {"const": "loop-work-identity/v1"},
    "work_lineage_id": {"$ref": "#/$defs/id"},
    "logical_task_id": {"$ref": "#/$defs/id"},
    "phase": {"type": "string", "pattern": "^(?:group\\.)?(?:[BCGH](?:\\.[BCGH][0-9]+|[0-9]+)?|D(?:\\.D(?:[1-9]|1[0-2])|(?:[1-9]|1[0-2]))|E(?:\\.E[3-9]|[3-9]))$"},
    "scope_revision": {"$ref": "#/$defs/id"},
    "requirements_digest": {"$ref": "#/$defs/digest"},
    "predecessor_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}},
      "anyOf": [{"required": ["id"]}, {"required": ["path"]}]
    }
  }
}
