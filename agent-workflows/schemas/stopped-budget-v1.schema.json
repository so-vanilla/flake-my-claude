{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stopped-budget-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "terminal_id", "contract_version", "expected_head", "source_disposition_ref", "reason", "derived_counters", "budget", "lease_closure", "revoked_dispatch_ids", "dispatch_authority", "non_dispatch", "terminal", "reopen_requirements", "terminal_digest"],
  "properties": {
    "schema": {"const": "stopped-budget/v1"}, "terminal_id": {"type": "string", "minLength": 1}, "contract_version": {"const": "workflow-execution/v2"},
    "expected_head": {"type": "object", "additionalProperties": false, "required": ["revision", "transaction_digest"], "properties": {"revision": {"type": "integer", "minimum": 0}, "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "source_disposition_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "reason": {"enum": ["budget-insufficient", "review-round-exhausted", "product-fix-attempt-exhausted"]},
    "derived_counters": {"type": "object", "additionalProperties": false, "required": ["review_round", "product_fix_attempts", "non_product_retry_classes"], "properties": {"review_round": {"type": "integer", "minimum": 1}, "product_fix_attempts": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fingerprint", "count"], "properties": {"fingerprint": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 0}}}}, "non_product_retry_classes": {"type": "object", "additionalProperties": false, "required": ["test_fixture_correction", "command_or_capture_retry", "package_or_report_correction"], "properties": {"test_fixture_correction": {"type": "integer", "minimum": 0}, "command_or_capture_retry": {"type": "integer", "minimum": 0}, "package_or_report_correction": {"type": "integer", "minimum": 0}}}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["remaining_seconds", "required_seconds"], "properties": {"remaining_seconds": {"type": "integer", "minimum": 0}, "required_seconds": {"type": "integer", "minimum": 0}}},
    "lease_closure": {"type": "object", "additionalProperties": false, "required": ["lease_id", "status"], "properties": {"lease_id": {"type": "string", "minLength": 1}, "status": {"const": "closed"}}},
    "revoked_dispatch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dispatch_authority": {"type": "null"}, "non_dispatch": {"const": true}, "terminal": {"const": true},
    "reopen_requirements": {"type": "object", "additionalProperties": false, "required": ["prior_terminal_digest", "expected_head", "new_lease", "replacement_budget_version_and_value"], "properties": {"prior_terminal_digest": {"const": true}, "expected_head": {"const": true}, "new_lease": {"const": true}, "replacement_budget_version_and_value": {"const": true}}},
    "terminal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
