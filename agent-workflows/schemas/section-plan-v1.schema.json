{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "section-plan-v1.schema.json",
  "title": "Digest-bound source section plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "section", "groups", "authority", "expected_head", "plan", "catalog", "idempotency_key"],
  "properties": {
    "schema": {"const": "section-plan/v1"},
    "section": {"type": "object", "additionalProperties": false, "required": ["id", "workflow_id", "version"], "properties": {"id": {"type": "string", "pattern": "^S[0-9]+$"}, "workflow_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "depends_on", "first_epoch", "first_frontier"], "properties": {"id": {"type": "string", "minLength": 1}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "first_epoch": {"type": "string", "minLength": 1}, "first_frontier": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"}}}}},
    "closed_bootstrap": {"type": "object", "additionalProperties": false, "required": ["run_id", "workflow_version", "group_id", "status", "ready", "next_group", "clear_boundary", "plan_digest", "catalog_digest", "checkpoint_ref", "bundle_ref", "lifecycle_prerequisite", "closed_group_receipt"], "properties": {"run_id": {"type": "string", "minLength": 1}, "workflow_version": {"type": "string", "minLength": 1}, "group_id": {"type": "string", "minLength": 1}, "status": {"const": "paused_after_group"}, "ready": {"type": "array", "maxItems": 0}, "next_group": {"type": "string", "minLength": 1}, "clear_boundary": {"const": true}, "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "checkpoint_ref": {"type":"object", "additionalProperties":false, "required":["checkpoint_id","digest"], "properties":{"checkpoint_id":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}, "bundle_ref": {"type":"object", "additionalProperties":false, "required":["digest"], "properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}, "lifecycle_prerequisite":{"type":"object","additionalProperties":false,"required":["kind","receipt_digest"],"properties":{"kind":{"enum":["closed-bootstrap","accepted-section"]},"group_id":{"type":"string","minLength":1},"section_id":{"type":"string","pattern":"^S[0-9]+$"},"receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}, "closed_group_receipt":{"type":"object","additionalProperties":false,"required":["group_id","digest"],"properties":{"group_id":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}}},
    "accepted_section": {"type":"object","additionalProperties":false,"required":["run_id","workflow_version","section_id","status","ready","next_section","clear_boundary","plan_digest","catalog_digest","checkpoint_ref","bundle_ref","lifecycle_prerequisite","accepted_section_receipt","section_history"],"properties":{"run_id":{"type":"string","minLength":1},"workflow_version":{"type":"string","minLength":1},"section_id":{"type":"string","pattern":"^S[0-9]+$"},"status":{"const":"paused_after_group"},"ready":{"type":"array","maxItems":0},"next_section":{"type":"string","pattern":"^S[0-9]+$"},"clear_boundary":{"const":true},"plan_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"catalog_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"checkpoint_ref":{"type":"object","additionalProperties":false,"required":["digest","object_type","path"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"object_type":{"const":"checkpoint"},"path":{"type":"string","pattern":"^objects/[0-9a-f]{64}\\.json$"}}},"bundle_ref":{"type":"object","additionalProperties":false,"required":["digest","object_type","path"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"object_type":{"const":"artifact-bundle"},"path":{"type":"string","pattern":"^objects/[0-9a-f]{64}\\.json$"}}},"lifecycle_prerequisite":{"type":"object","additionalProperties":false,"required":["kind","section_id","receipt_digest"],"properties":{"kind":{"const":"accepted-section"},"section_id":{"type":"string","pattern":"^S[0-9]+$"},"receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}},"accepted_section_receipt":{"type":"object","additionalProperties":false,"required":["digest","object_type","path"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"object_type":{"const":"artifact"},"path":{"type":"string","pattern":"^objects/[0-9a-f]{64}\\.json$"}}},"section_history":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["position","section_id","accepted_receipt_ref","bundle_ref","checkpoint_ref"],"properties":{"position":{"type":"integer","minimum":0},"section_id":{"type":"string","pattern":"^S[0-9]+$"},"accepted_receipt_ref":{"type":"object","additionalProperties":false,"required":["digest","object_type","path"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"object_type":{"const":"artifact"},"path":{"type":"string","pattern":"^objects/[0-9a-f]{64}\\.json$"}}},"bundle_ref":{"type":"object","additionalProperties":false,"required":["digest","object_type","path"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"object_type":{"const":"artifact-bundle"},"path":{"type":"string","pattern":"^objects/[0-9a-f]{64}\\.json$"}}},"checkpoint_ref":{"type":"object","additionalProperties":false,"required":["digest","object_type","path"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"object_type":{"const":"checkpoint"},"path":{"type":"string","pattern":"^objects/[0-9a-f]{64}\\.json$"}}}}}}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["approved", "scopes", "protected_fields", "human_receipt", "expected_head", "execution_class"], "properties": {"approved":{"const":true}, "scopes": {"type": "array", "minItems": 3, "uniqueItems":true, "items": {"type": "string", "minLength": 1}}, "protected_fields":{"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}}, "human_receipt":{"type":"string","minLength":1}, "expected_head":{"type":"object","additionalProperties":false,"required":["revision","transaction_digest"],"properties":{"revision":{"type":"integer","minimum":0},"transaction_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}, "execution_class": {"const": "candidate-generic"}}},
    "expected_head": {"type": "object", "additionalProperties": false, "required": ["revision", "transaction_digest"], "properties": {"revision": {"type": "integer", "minimum": 0}, "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "plan":{"type":"object","additionalProperties":false,"required":["digest"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}},
    "catalog":{"type":"object","additionalProperties":false,"required":["digest","tasks"],"properties":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"tasks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","section_id","group_id","epoch_id"],"properties":{"id":{"type":"string","pattern":"^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"},"section_id":{"type":"string","pattern":"^S[0-9]+$"},"group_id":{"type":"string","minLength":1},"epoch_id":{"type":"string","minLength":1}}}}}},
    "idempotency_key": {"type": "string", "minLength": 1}
  },
  "oneOf": [{"required":["closed_bootstrap"]}, {"required":["accepted_section"]}]
}
