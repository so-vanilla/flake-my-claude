  "allOf": [
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E1"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E2"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E3"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E4"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E5"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E6"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E7"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E8"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.E.E9"}}, "required": ["qualified_id"]}}}},
