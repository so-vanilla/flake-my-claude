    "contract_base": {"type": "object", "additionalProperties": false, "required": ["qualified_id", "local_id", "status", "source_ref", "selector_ref", "receipt_ref"], "properties": {"qualified_id": {"enum": ["group.E.E1", "group.E.E2", "group.E.E3", "group.E.E4", "group.E.E5", "group.E.E6", "group.E.E7", "group.E.E8", "group.E.E9", "group.E.E10"]}, "local_id": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "E9", "E10"]}, "status": {"const": "candidate-source"}, "source_ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^agent-workflows/skills/[a-z0-9-]+/SKILL\\.md$"}, "digest": {"$ref": "#/$defs/digest"}}}, "selector_ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "selector"], "properties": {"path": {"const": "agent-workflows/src/ai_agent_workflow/execution_group.py"}, "digest": {"$ref": "#/$defs/digest"}, "selector": {"enum": ["ExecutionGroupV1.compile(group.E.E1)", "ExecutionGroupV1.compile(group.E.E2)", "ExecutionGroupV1.compile(group.E.E3)", "ExecutionGroupV1.compile(group.E.E4)", "ExecutionGroupV1.compile(group.E.E5)", "ExecutionGroupV1.compile(group.E.E6)", "ExecutionGroupV1.compile(group.E.E7)", "ExecutionGroupV1.compile(group.E.E8)", "ExecutionGroupV1.compile(group.E.E9)", "ExecutionGroupV1.compile(group.E.E10)"]}}}, "receipt_ref": {"$ref": "#/$defs/physical_ref"}}},
    "contract": {"oneOf": [
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E1"}, "local_id": {"const": "E1"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/execution-preflight/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E1)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E1.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E2"}, "local_id": {"const": "E2"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/dispatch-task/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E2)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E2.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E3"}, "local_id": {"const": "E3"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/execute-small-loop/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E3)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E3.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E4"}, "local_id": {"const": "E4"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/review-task-spec/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E4)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E4.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E5"}, "local_id": {"const": "E5"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/review-task-quality/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E5)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E5.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E6"}, "local_id": {"const": "E6"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/validate-review-findings/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E6)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E6.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E7"}, "local_id": {"const": "E7"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/fix-and-rereview/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E7)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E7.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E8"}, "local_id": {"const": "E8"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/converge-parallel-batch/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E8)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E8.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E9"}, "local_id": {"const": "E9"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/verify-whole-change/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E9)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E9.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.E.E10"}, "local_id": {"const": "E10"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/arbitrate-exception/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "ExecutionGroupV1.compile(group.E.E10)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/E10.json"}}}}}]}
    ]}
  }
}
