{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "next-group-advice/v1",
  "title": "Fully bound next-group advice",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workflow_ref", "state_ref", "checkpoint_ref", "input_refs", "clear_boundary", "expected_head", "future_plan_ref", "next_group"],
  "properties": {
    "schema": {"const": "next-group-advice/v1"},
    "workflow_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest", "object_type", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "object_type": {"const": "workflow"},
        "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}
      }
    },
    "state_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "digest", "object_type", "path"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "object_type": {"const": "dag-state"},
        "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}
      }
    },
    "checkpoint_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "object_type", "path", "state_digest", "expected_head"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "object_type": {"const": "checkpoint"},
        "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"},
        "state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "expected_head": {
          "type": "object", "additionalProperties": false,
          "required": ["revision", "transaction_digest"],
          "properties": {
            "revision": {"type": "integer", "minimum": 0},
            "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "input_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "digest", "object_type", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "object_type": {"const": "artifact"},
          "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}
        }
      }
    },
    "clear_boundary": {"const": true},
    "expected_head": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "transaction_digest"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "future_plan_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest", "object_type", "path", "workflow_digest", "state_digest", "checkpoint_digest", "input_digests", "clear_boundary", "expected_head", "next_group"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "object_type": {"const": "future-plan"},
        "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"},
        "workflow_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "checkpoint_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "input_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "clear_boundary": {"const": true},
        "expected_head": {
          "type": "object", "additionalProperties": false,
          "required": ["revision", "transaction_digest"],
          "properties": {
            "revision": {"type": "integer", "minimum": 0},
            "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "next_group": {"type": "string", "minLength": 1}
      }
    },
    "next_group": {"type": "string", "minLength": 1}
  }
}
