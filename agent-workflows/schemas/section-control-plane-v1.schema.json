{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "section-control-plane-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "section",
    "schedule",
    "open_section",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "section-control-plane/v1"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflow_id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "section_id",
        "workflow_id",
        "groups",
        "first_frontier"
      ],
      "properties": {
        "schema": {
          "const": "section-schedule/v1"
        },
        "section_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "first_epoch",
              "first_frontier"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "first_epoch": {
                "type": "string",
                "minLength": 1
              },
              "first_frontier": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"
                }
              }
            }
          }
        },
        "first_frontier": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"
          }
        }
      }
    },
    "open_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "command_id",
        "command_type",
        "run_id",
        "expected_head",
        "workflow_version",
        "graph_version",
        "actor",
        "authority_ref",
        "input_refs",
        "idempotency_key",
        "protected_fields",
        "scope",
        "payload"
      ],
      "properties": {
        "schema": {
          "const": "dag-command/v1"
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "command_type": {
          "const": "open_section"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_head": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "transaction_digest"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "transaction_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "workflow_version": {
          "type": "string",
          "minLength": 1
        },
        "graph_version": {
          "const": "artifact-task-dag/v1"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "assignment_id"
          ],
          "properties": {
            "role": {
              "const": "orchestrator"
            },
            "assignment_id": {
              "const": "section-control-plane"
            }
          }
        },
        "authority_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved",
            "scopes",
            "protected_fields",
            "human_receipt",
            "expected_head",
            "execution_class"
          ],
          "properties": {
            "approved": {
              "const": true
            },
            "scopes": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "protected_fields": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "human_receipt": {
              "type": "string",
              "minLength": 1
            },
            "expected_head": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revision",
                "transaction_digest"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "transaction_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "execution_class": {
              "const": "candidate-generic"
            }
          }
        },
        "input_refs": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "digest"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "plan",
                  "catalog",
                  "checkpoint",
                  "bundle",
                  "lifecycle_prerequisite",
                  "closed_group_receipt",
                  "accepted_section_receipt"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "protected_fields": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "source"
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "group",
            "first_frontier",
            "preconditions",
            "transition"
          ],
          "properties": {
            "section": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "workflow_id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S[0-9]+$"
                },
                "workflow_id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "group": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "first_epoch"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "first_epoch": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "first_frontier": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"
              }
            },
            "preconditions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plan_digest",
                "catalog_digest",
                "lifecycle_prerequisite_digest",
                "checkpoint_digest",
                "bundle_digest"
              ],
              "properties": {
                "plan_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "catalog_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "closed_group_id": {
                  "type": "string",
                  "minLength": 1
                },
                "closed_group_receipt_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "predecessor_section_id": {
                  "type": "string",
                  "pattern": "^S[0-9]+$"
                },
                "accepted_section_receipt_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "lifecycle_prerequisite_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "checkpoint_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "bundle_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "transition": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "intent",
                "state"
              ],
              "properties": {
                "intent": {
                  "const": "source-transition-fixture-passed"
                },
                "state": {
                  "const": "pending"
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "section_id", "status", "group", "epoch", "ready", "head", "claims", "transition_evidence"],
      "properties": {
        "schema": {"const": "section-status/v1"},
        "section_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "status": {"const": "active"},
        "group": {"type": "object", "additionalProperties": false, "required": ["id", "status", "next_group"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"const": "open"}, "next_group": {"const": null}}},
        "epoch": {"type": "object", "additionalProperties": false, "required": ["id", "status", "group_id", "boundary_reason", "clear_before_next"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"const": "open"}, "group_id": {"type": "string", "minLength": 1}, "boundary_reason": {"const": "open_section"}, "clear_before_next": {"const": false}}},
        "ready": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"}},
        "head": {"type": "object", "additionalProperties": false, "required": ["revision", "transaction_digest"], "properties": {"revision": {"type": "integer", "minimum": 0}, "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "claims": {"type": "object", "additionalProperties": false, "required": ["source_transition_fixture_passed", "actual_a7", "activation", "full_ready"], "properties": {"source_transition_fixture_passed": {"const": false}, "actual_a7": {"const": false}, "activation": {"const": false}, "full_ready": {"const": false}}},
        "transition_evidence": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"const": "pending"}}},
        "section_history": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["position", "section_id", "accepted_receipt_ref", "bundle_ref", "checkpoint_ref"], "properties": {"position": {"type": "integer", "minimum": 0}, "section_id": {"type": "string", "pattern": "^S[0-9]+$"}, "accepted_receipt_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "artifact"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "bundle_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "artifact-bundle"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "checkpoint_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "checkpoint"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}}}}
      },
      "oneOf": [
        {"properties": {"section_id": {"const": "S0"}, "section_history": {"type": "array", "maxItems": 0, "items": {}}}},
        {"required": ["section_history"], "properties": {"section_id": {"type": "string", "pattern": "^S[1-9][0-9]*$"}, "section_history": {"type": "array", "minItems": 1, "items": {}}}}
      ]
    }
  }
}
