{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "receipt-aggregate-v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema", "candidate_ref", "execution_closure_digest", "shard_plan_digest", "receipt_refs", "coverage", "terminal_complete", "accepted", "reused_receipt_ids", "aggregate_digest"],
  "properties": {
    "schema": {"const": "receipt-aggregate/v1"}, "candidate_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "execution_closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "shard_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_digest", "shard_id", "execution_closure_ref", "status"], "properties": {"receipt_id": {"type": "string", "minLength": 1}, "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "shard_id": {"type": "string", "minLength": 1}, "execution_closure_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "status": {"enum": ["passed", "failed", "timed_out", "interrupted"]}}}},
    "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "terminal_complete": {"const": true}, "accepted": {"type": "boolean"}, "reused_receipt_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "aggregate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
