{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macos-task-process-release-v2.schema.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?/).+[^/]$"},
    "state_writer_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer",
        "task_child_is_writer",
        "broker_state_root",
        "task_write_roots",
        "task_write_scope_disjoint",
        "descriptor_anchored",
        "no_follow",
        "device_inode_revalidated",
        "pre_post_attachment_checks",
        "rollback",
        "arbitrary_same_uid_atomicity",
        "publication_sigkill_atomicity"
      ],
      "properties": {
        "writer": {"const": "trusted-same-uid-parent"},
        "task_child_is_writer": {"const": false},
        "broker_state_root": {"$ref": "#/$defs/absolute_path"},
        "task_write_roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
        "task_write_scope_disjoint": {"const": true},
        "descriptor_anchored": {"const": true},
        "no_follow": {"const": true},
        "device_inode_revalidated": {"const": true},
        "pre_post_attachment_checks": {"const": true},
        "rollback": {"const": "defense-in-depth"},
        "arbitrary_same_uid_atomicity": {"const": false},
        "publication_sigkill_atomicity": {"const": false}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine",
    "profile_imports",
    "workspace_identity",
    "broker_state_root",
    "system_read_roots",
    "runtime_read_roots",
    "project_read_roots",
    "write_roots",
    "command",
    "execution_closure_ref",
    "profile",
    "profile_digest",
    "os_isolation_enforced",
    "release_rule",
    "threat_profile",
    "threat_profile_digest",
    "state_writer_boundary",
    "release_digest"
  ],
  "properties": {
    "schema": {"const": "macos-task-process-release/v2"},
    "engine": {"const": "/usr/bin/sandbox-exec"},
    "profile_imports": {"const": ["dyld-support.sb"]},
    "workspace_identity": {"$ref": "#/$defs/absolute_path"},
    "broker_state_root": {"$ref": "#/$defs/absolute_path"},
    "system_read_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "runtime_read_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "project_read_roots": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "write_roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"$ref": "#/$defs/absolute_path"}
      }
    },
    "execution_closure_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "profile": {"type": "string", "minLength": 1},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "os_isolation_enforced": {"const": true},
    "release_rule": {"const": "broker-only"},
    "threat_profile": {"$ref": "macos-practical-threat-profile-v1.schema.json"},
    "threat_profile_digest": {"const": "sha256:81d2c7823b100e00f3d68e8f2c0877507064ffdc6e935f822130510106cfc955"},
    "state_writer_boundary": {"$ref": "#/$defs/state_writer_boundary"},
    "release_digest": {"$ref": "#/$defs/digest"}
  }
}
