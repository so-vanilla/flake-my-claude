{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group-b-manifest-v1.schema.json",
  "title": "Strict physical Group B Skill contract map",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "group_id", "implementation_kind", "contracts"],
  "properties": {
    "schema": {"const": "group-b-manifest/v1"}, "group_id": {"const": "agent-workflows.group.B"}, "implementation_kind": {"const": "skill"},
    "contracts": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/contract"}, "allOf": [{"contains": {"properties": {"qualified_id": {"const": "group.B.B1"}}}}, {"contains": {"properties": {"qualified_id": {"const": "group.B.B2"}}}}, {"contains": {"properties": {"qualified_id": {"const": "group.B.B3"}}}}, {"contains": {"properties": {"qualified_id": {"const": "group.B.B4"}}}}, {"contains": {"properties": {"qualified_id": {"const": "group.B.B5"}}}}, {"contains": {"properties": {"qualified_id": {"const": "group.B.B6"}}}}, {"contains": {"properties": {"qualified_id": {"const": "group.B.B7"}}}}]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "selector"], "properties": {"path": {"type": "string", "pattern": "^(?:agent-workflows|docs|\\.local)/.+"}, "digest": {"$ref": "#/$defs/digest"}, "selector": {"type": "string", "minLength": 1}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^(?:agent-workflows|docs|\\.local)/.+"}, "digest": {"$ref": "#/$defs/digest"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["qualified_id", "local_id", "selector", "source_ref", "selector_ref", "receipt_ref"], "properties": {"qualified_id": {"enum": ["group.B.B1", "group.B.B2", "group.B.B3", "group.B.B4", "group.B.B5", "group.B.B6", "group.B.B7"]}, "local_id": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7"]}, "selector": {"enum": ["entry", "discover-context", "classify-scope", "grill-purpose", "propose-true-purpose", "assess-feasibility-and-constraints", "approve-objective"]}, "source_ref": {"$ref": "#/$defs/ref"}, "selector_ref": {"$ref": "#/$defs/ref"}, "receipt_ref": {"$ref": "#/$defs/receipt"}}, "oneOf": [{"properties": {"qualified_id": {"const": "group.B.B1"}, "local_id": {"const": "B1"}, "selector": {"const": "entry"}}}, {"properties": {"qualified_id": {"const": "group.B.B2"}, "local_id": {"const": "B2"}, "selector": {"const": "discover-context"}}}, {"properties": {"qualified_id": {"const": "group.B.B3"}, "local_id": {"const": "B3"}, "selector": {"const": "classify-scope"}}}, {"properties": {"qualified_id": {"const": "group.B.B4"}, "local_id": {"const": "B4"}, "selector": {"const": "grill-purpose"}}}, {"properties": {"qualified_id": {"const": "group.B.B5"}, "local_id": {"const": "B5"}, "selector": {"const": "propose-true-purpose"}}}, {"properties": {"qualified_id": {"const": "group.B.B6"}, "local_id": {"const": "B6"}, "selector": {"const": "assess-feasibility-and-constraints"}}}, {"properties": {"qualified_id": {"const": "group.B.B7"}, "local_id": {"const": "B7"}, "selector": {"const": "approve-objective"}}}]}
  }
}
