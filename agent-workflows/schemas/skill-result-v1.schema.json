{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-result/v1",
  "title": "Workflow Skill result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "result",
    "workflow_version",
    "context_epoch",
    "input_state_revision",
    "produced_state_revision",
    "checkpoint_id",
    "outcome",
    "artifact_paths",
    "artifact_digests",
    "artifact_bundle",
    "acceptance_evidence",
    "purpose_alignment",
    "next_skill_advice",
    "model_advice"
  ],
  "properties": {
    "result": { "type": "object" },
    "workflow_version": { "type": "string", "minLength": 1 },
    "context_epoch": {
      "type": "object",
      "required": ["id", "group_id", "boundary_reason", "token_status", "token_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "group_id": { "type": "string", "minLength": 1 },
        "boundary_reason": { "type": "string", "minLength": 1 },
        "token_status": { "enum": ["exact", "estimated", "unavailable"] },
        "token_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "input_state_revision": { "type": "integer", "minimum": 0 },
    "produced_state_revision": { "type": "integer", "minimum": 0 },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["completed", "blocked", "needs_decision"] },
    "artifact_paths": { "type": "array", "items": { "type": "string" } },
    "artifact_digests": { "type": "array", "items": { "type": "string" } },
    "artifact_bundle": { "type": "object" },
    "acceptance_evidence": { "type": "array" },
    "purpose_alignment": {
      "type": "object",
      "required": ["status", "explanation"],
      "properties": {
        "status": { "enum": ["aligned", "uncertain", "diverged"] },
        "explanation": { "type": "string" }
      }
    },
    "next_skill_advice": { "type": "object" },
    "model_advice": { "type": "object" }
  }
}
