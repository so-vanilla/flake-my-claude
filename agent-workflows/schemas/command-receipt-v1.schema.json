{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-receipt-v1.schema.json",
  "$defs": {
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "package_id", "execution_closure", "execution_closure_ref", "shard_id", "coverage", "idempotency_key", "nonce", "supervisor_lease", "retry_class"],
      "properties": {
        "schema": {"const": "execution-package/v1"}, "package_id": {"type": "string", "minLength": 1},
        "execution_closure": {"$ref": "execution-package-closure-v2.schema.json"},
        "execution_closure_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "shard_id": {"type": "string", "minLength": 1}, "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "idempotency_key": {"type": "string", "minLength": 1}, "nonce": {"type": "string", "minLength": 1}, "supervisor_lease": {"type": "string", "minLength": 1},
        "retry_class": {"enum": ["none", "test-fixture-correction", "command-or-capture-retry", "package-or-report-correction"]}
      }
    },
    "execution_package": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "package_id", "execution_closure", "execution_closure_ref", "shard_id", "coverage", "idempotency_key", "nonce", "supervisor_lease", "retry_class"],
      "properties": {
        "schema": {"const": "execution-package/v1"}, "package_id": {"type": "string", "minLength": 1},
        "execution_closure": {"$ref": "execution-package-closure-v2.schema.json"},
        "execution_closure_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "shard_id": {"type": "string", "minLength": 1}, "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "idempotency_key": {"type": "string", "minLength": 1}, "nonce": {"type": "string", "minLength": 1}, "supervisor_lease": {"type": "string", "minLength": 1},
        "retry_class": {"enum": ["none", "test-fixture-correction", "command-or-capture-retry", "package-or-report-correction"]}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema", "receipt_id", "shard_id", "candidate_digest", "execution_closure_digest", "idempotency_key", "payload_digest", "status", "coverage", "capture_state", "terminal", "receipt_digest"],
  "properties": {
    "schema": {"const": "command-receipt/v1"}, "receipt_id": {"type": "string", "minLength": 1}, "shard_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "execution_closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 1}, "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["passed", "failed", "timed_out", "interrupted"]}, "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capture_state": {"type": "object", "additionalProperties": false, "required": ["stdout", "stderr"], "properties": {"stdout": {"enum": ["complete", "truncated"]}, "stderr": {"enum": ["complete", "truncated"]}}},
    "terminal": {"const": true}, "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
