{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "regression-shard-plan-v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema", "candidate_ref", "execution_closure_digest", "execution_closure", "regression_inventory", "shards", "plan_digest"],
  "properties": {
    "schema": {"const": "regression-shard-plan/v1"},
    "candidate_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "execution_closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_closure": {"$ref": "execution-package-closure-v2.schema.json"},
    "regression_inventory": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "shards": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["shard_id", "members", "command", "resource_claims", "isolation", "execution_closure", "execution_closure_ref"], "properties": {"shard_id": {"type": "string", "minLength": 1}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "command": {"type": "object", "additionalProperties": false, "required": ["argv"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}, "resource_claims": {"type": "object", "additionalProperties": false, "required": ["read_paths", "write_paths", "exclusive_resources"], "properties": {"read_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "write_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "exclusive_resources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}, "isolation": {"type": "object", "additionalProperties": false, "required": ["cwd", "temporary_namespace", "output_namespace"], "properties": {"cwd": {"type": "string", "minLength": 1}, "temporary_namespace": {"type": "string", "minLength": 1}, "output_namespace": {"type": "string", "minLength": 1}}}, "execution_closure": {"$ref": "execution-package-closure-v2.schema.json"}, "execution_closure_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}}},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
