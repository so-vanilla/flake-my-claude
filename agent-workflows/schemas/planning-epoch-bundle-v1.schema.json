{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planning-epoch-bundle-v1.schema.json",
  "title": "Closed, digest-bound Group D epoch bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "epoch_id", "authority_digest", "canonical_refs", "selector_receipts", "acceptance_evidence", "approved_decisions", "unresolved", "invalidated", "next_inputs"],
  "properties": {
    "schema": {"const": "planning-epoch-bundle/v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "epoch_id": {"enum": ["D-01", "D-02", "D-03"]},
    "authority_digest": {"$ref": "#/$defs/digest"},
    "canonical_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "selector_receipts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ref"}},
    "acceptance_evidence": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "approved_decisions": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "invalidated": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "next_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "predecessor_ref": {"$ref": "#/$defs/predecessor"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "version", "digest"], "properties": {"path": {"type": "string", "pattern": "^(?!/).+"}, "version": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["epoch_id", "path", "digest"], "properties": {"epoch_id": {"enum": ["D-01", "D-02"]}, "path": {"type": "string", "pattern": "^(?!/).+"}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
