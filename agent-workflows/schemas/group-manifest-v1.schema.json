{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group-manifest/v1",
  "title": "Strict qualified contract map for one named Skill Group",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "group_id", "implementation_kind", "contracts"],
  "properties": {
    "schema": {"const": "group-manifest/v1"},
    "group_id": {"const": "agent-workflows.group.A"},
    "implementation_kind": {"const": "skill"},
    "contracts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["qualified_id", "local_id", "status", "source_ref", "selector_ref", "receipt_ref"],
        "properties": {
          "qualified_id": {"enum": ["group.A.A1", "group.A.A2", "group.A.A3", "group.A.A4", "group.A.A5", "group.A.A6", "group.A.A6R", "group.A.A7"]},
          "local_id": {"enum": ["A1", "A2", "A3", "A4", "A5", "A6", "A6R", "A7"]},
          "status": {"enum": ["candidate-source", "retained-accepted"]},
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          },
          "selector_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest", "selector"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "selector": {"type": "string", "minLength": 1}
            }
          },
          "receipt_ref": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
