{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objective-approval-v1.schema.json",
  "title": "Explicit fixture or project-local objective approval",
  "$ref": "#/$defs/approval",
  "$defs": {
    "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "identifier": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"},
    "namespace": {"type":"string","pattern":"^fixture:[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_id",
        "approval_id",
        "decision",
        "explicit",
        "source",
        "actor_id",
        "run_id",
        "namespace",
        "approval_scope",
        "candidate_path",
        "candidate_version",
        "candidate_namespace",
        "candidate_digest",
        "prior_objective_digest",
        "prior_objective_version",
        "proposal_digest",
        "issued_at"
      ],
      "properties": {
        "schema": {"const":"human-approval-receipt/v1"},
        "receipt_id": {"$ref":"#/$defs/identifier"},
        "approval_id": {"$ref":"#/$defs/identifier"},
        "decision": {"const":"approve"},
        "explicit": {"const":true},
        "source": {"const":"human"},
        "actor_id": {"$ref":"#/$defs/identifier"},
        "run_id": {"$ref":"#/$defs/identifier"},
        "namespace": {"$ref":"#/$defs/namespace"},
        "approval_scope": {"const":"fixture-only"},
        "candidate_path": {"type":"string","minLength":1},
        "candidate_version": {"$ref":"#/$defs/identifier"},
        "candidate_namespace": {"$ref":"#/$defs/namespace"},
        "candidate_digest": {"$ref":"#/$defs/digest"},
        "prior_objective_digest": {"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"},
        "prior_objective_version": {"$ref":"#/$defs/identifier"},
        "proposal_digest": {"$ref":"#/$defs/digest"},
        "issued_at": {"type":"string","format":"date-time"}
      }
    },
    "approval": {"oneOf":[{"$ref":"#/$defs/fixtureApproval"},{"$ref":"#/$defs/runtimeApproval"}]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path","version","digest","namespace"],
      "properties": {
        "path": {"type":"string","minLength":1},
        "version": {"$ref":"#/$defs/identifier"},
        "digest": {"$ref":"#/$defs/digest"},
        "namespace": {"$ref":"#/$defs/namespace"}
      }
    },
    "priorObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version","digest"],
      "properties": {"version":{"$ref":"#/$defs/identifier"},"digest":{"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"}}
    },
    "approvalCommandPayload": {"oneOf":[{"$ref":"#/$defs/fixtureApprovalCommandPayload"},{"$ref":"#/$defs/runtimeApprovalCommandPayload"}]},
    "fixtureReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_id",
        "approval_id",
        "decision",
        "explicit",
        "source",
        "actor_id",
        "run_id",
        "namespace",
        "approval_scope",
        "candidate_path",
        "candidate_version",
        "candidate_namespace",
        "candidate_digest",
        "prior_objective_digest",
        "prior_objective_version",
        "proposal_digest",
        "issued_at"
      ],
      "properties": {
        "schema": {"const":"human-approval-receipt/v1"},
        "receipt_id": {"$ref":"#/$defs/identifier"},
        "approval_id": {"$ref":"#/$defs/identifier"},
        "decision": {"const":"approve"},
        "explicit": {"const":true},
        "source": {"const":"human"},
        "actor_id": {"$ref":"#/$defs/identifier"},
        "run_id": {"$ref":"#/$defs/identifier"},
        "namespace": {"$ref":"#/$defs/namespace"},
        "approval_scope": {"const":"fixture-only"},
        "candidate_path": {"type":"string","minLength":1},
        "candidate_version": {"$ref":"#/$defs/identifier"},
        "candidate_namespace": {"$ref":"#/$defs/namespace"},
        "candidate_digest": {"$ref":"#/$defs/digest"},
        "prior_objective_digest": {"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"},
        "prior_objective_version": {"$ref":"#/$defs/identifier"},
        "proposal_digest": {"$ref":"#/$defs/digest"},
        "issued_at": {"type":"string","format":"date-time"}
      }
    },
    "fixtureApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "approval_id",
        "run_id",
        "namespace",
        "approval_scope",
        "decision",
        "actor",
        "receipt",
        "candidate_digest",
        "candidate_version",
        "prior_objective_digest",
        "prior_objective_version",
        "proposal_digest"
      ],
      "properties": {
        "schema": {"const":"objective-approval/v1"},
        "approval_id": {"$ref":"#/$defs/identifier"},
        "run_id": {"$ref":"#/$defs/identifier"},
        "namespace": {"$ref":"#/$defs/namespace"},
        "approval_scope": {"const":"fixture-only"},
        "decision": {"const":"approve"},
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind","actor_id"],
          "properties": {"kind":{"const":"human"},"actor_id":{"$ref":"#/$defs/identifier"}}
        },
        "receipt": {"$ref":"#/$defs/receipt"},
        "candidate_digest": {"$ref":"#/$defs/digest"},
        "candidate_version": {"$ref":"#/$defs/identifier"},
        "prior_objective_digest": {"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"},
        "prior_objective_version": {"$ref":"#/$defs/identifier"},
        "proposal_digest": {"$ref":"#/$defs/digest"}
      }
    },
    "fixtureCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path","version","digest","namespace"],
      "properties": {
        "path": {"type":"string","minLength":1},
        "version": {"$ref":"#/$defs/identifier"},
        "digest": {"$ref":"#/$defs/digest"},
        "namespace": {"$ref":"#/$defs/namespace"}
      }
    },
    "fixtureApprovalCommandPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref","prior_objective","proposal_digest","approval"],
      "properties": {
        "candidate_ref": {"$ref":"#/$defs/candidate"},
        "prior_objective": {"$ref":"#/$defs/priorObjective"},
        "proposal_digest": {"$ref":"#/$defs/digest"},
        "approval": {"$ref":"#/$defs/fixtureApproval"}
      }
    },
    "runtimeNamespace": {"type":"string","pattern":"^project:[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"},
    "runtimeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_id",
        "approval_id",
        "decision",
        "explicit",
        "source",
        "actor_id",
        "run_id",
        "namespace",
        "approval_scope",
        "candidate_path",
        "candidate_version",
        "candidate_namespace",
        "candidate_digest",
        "prior_objective_digest",
        "prior_objective_version",
        "proposal_digest",
        "issued_at",
        "project_root",
        "mode"
      ],
      "properties": {
        "schema": {"enum":["human-approval-receipt/v1","mock-approval-receipt/v1"]},
        "receipt_id": {"$ref":"#/$defs/identifier"},
        "approval_id": {"$ref":"#/$defs/identifier"},
        "decision": {"const":"approve"},
        "explicit": {"const":true},
        "source": {"enum":["human","mock"]},
        "actor_id": {"$ref":"#/$defs/identifier"},
        "run_id": {"$ref":"#/$defs/identifier"},
        "namespace": {"$ref":"#/$defs/runtimeNamespace"},
        "approval_scope": {"const":"project-local"},
        "candidate_path": {"type":"string","minLength":1},
        "candidate_version": {"$ref":"#/$defs/identifier"},
        "candidate_namespace": {"$ref":"#/$defs/runtimeNamespace"},
        "candidate_digest": {"$ref":"#/$defs/digest"},
        "prior_objective_digest": {"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"},
        "prior_objective_version": {"$ref":"#/$defs/identifier"},
        "proposal_digest": {"$ref":"#/$defs/digest"},
        "issued_at": {"type":"string","format":"date-time"},
        "project_root": {"type":"string","pattern":"^/"},
        "mode": {"enum":["real","rehearsal"]}
      },
      "oneOf": [
        {"properties":{"mode":{"const":"real"},"source":{"const":"human"},"schema":{"const":"human-approval-receipt/v1"}}},
        {"properties":{"mode":{"const":"rehearsal"},"source":{"const":"mock"},"schema":{"const":"mock-approval-receipt/v1"}}}
      ]
    },
    "runtimeApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "approval_id",
        "run_id",
        "namespace",
        "approval_scope",
        "decision",
        "actor",
        "receipt",
        "candidate_digest",
        "candidate_version",
        "prior_objective_digest",
        "prior_objective_version",
        "proposal_digest",
        "project_root",
        "mode"
      ],
      "properties": {
        "schema": {"const":"objective-approval/v1"},
        "approval_id": {"$ref":"#/$defs/identifier"},
        "run_id": {"$ref":"#/$defs/identifier"},
        "namespace": {"$ref":"#/$defs/runtimeNamespace"},
        "approval_scope": {"const":"project-local"},
        "decision": {"const":"approve"},
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind","actor_id"],
          "properties": {"kind":{"enum":["human","mock"]},"actor_id":{"$ref":"#/$defs/identifier"}}
        },
        "receipt": {"$ref":"#/$defs/runtimeReceipt"},
        "candidate_digest": {"$ref":"#/$defs/digest"},
        "candidate_version": {"$ref":"#/$defs/identifier"},
        "prior_objective_digest": {"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"},
        "prior_objective_version": {"$ref":"#/$defs/identifier"},
        "proposal_digest": {"$ref":"#/$defs/digest"},
        "project_root": {"type":"string","pattern":"^/"},
        "mode": {"enum":["real","rehearsal"]}
      },
      "oneOf": [
        {"properties":{"mode":{"const":"real"},"actor":{"properties":{"kind":{"const":"human"}}},"receipt":{"properties":{"mode":{"const":"real"}}}}},
        {"properties":{"mode":{"const":"rehearsal"},"actor":{"properties":{"kind":{"const":"mock"}}},"receipt":{"properties":{"mode":{"const":"rehearsal"}}}}}
      ]
    },
    "runtimeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path","version","digest","namespace"],
      "properties": {
        "path": {"type":"string","minLength":1},
        "version": {"$ref":"#/$defs/identifier"},
        "digest": {"$ref":"#/$defs/digest"},
        "namespace": {"$ref":"#/$defs/runtimeNamespace"}
      }
    },
    "runtimeApprovalCommandPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref","prior_objective","proposal_digest","approval"],
      "properties": {
        "candidate_ref": {"$ref":"#/$defs/runtimeCandidate"},
        "prior_objective": {"$ref":"#/$defs/priorObjective"},
        "proposal_digest": {"$ref":"#/$defs/digest"},
        "approval": {"$ref":"#/$defs/runtimeApproval"}
      }
    }
  }
}
