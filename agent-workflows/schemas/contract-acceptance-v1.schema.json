{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract-acceptance-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "contract_name",
    "coverage_kind",
    "implementation_ref",
    "test_ref",
    "status"
  ],
  "properties": {
    "schema": {"const": "agent-workflow-contract-acceptance/v1"},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_name": {"type": "string", "minLength": 1},
    "coverage_kind": {"enum": ["named-skill", "profile-step"]},
    "implementation_ref": {"$ref": "#/$defs/contentRef"},
    "test_ref": {"$ref": "#/$defs/testRef"},
    "status": {"const": "passed"}
  },
  "$defs": {
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "testRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "selector"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "selector": {"type": "string", "minLength": 1}
      }
    }
  }
}
