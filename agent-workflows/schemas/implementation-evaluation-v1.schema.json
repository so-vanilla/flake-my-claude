{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-evaluation-v1.schema.json",
  "title": "Evidence-derived source-wide evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product_id",
    "release_id",
    "release_scope",
    "release_scope_status",
    "overall_status",
    "source_wide_integration_complete",
    "full_workflow_ready",
    "activation_policy",
    "completion_registry",
    "coverage",
    "required_source_findings",
    "pending_source_gates",
    "pending_operational_gates",
    "missing_required_surfaces",
    "pending_completion_gates",
    "source_refs",
    "s0_coverage",
    "claims"
  ],
  "properties": {
    "schema": {"const": "agent-workflow-implementation-evaluation/v1"},
    "product_id": {"const": "personal-ai-agent-workflow-v1"},
    "release_id": {"const": "source-release/v1"},
    "release_scope": {"const": "source-wide"},
    "release_scope_status": {"const": "source-complete"},
    "overall_status": {"const": "source-complete-operationally-pending"},
    "source_wide_integration_complete": {"const": true},
    "full_workflow_ready": {"const": false},
    "activation_policy": {"const": "separate-explicit-user-approval-required"},
    "completion_registry": {"const": "full-workflow-readiness/v1"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "named_contracts",
        "profile_steps",
        "required_surfaces",
        "distributed_skills",
        "shared_protocol_operations"
      ],
      "properties": {
        "named_contracts": {"$ref": "#/$defs/coverage"},
        "profile_steps": {"$ref": "#/$defs/coverage"},
        "required_surfaces": {"$ref": "#/$defs/coverage"},
        "distributed_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "shared_protocol_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^group\\.F\\.F[1-8]$"}
        }
      }
    },
    "required_source_findings": {"const": 0},
    "pending_source_gates": {"const": []},
    "pending_operational_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "missing_required_surfaces": {"const": []},
    "pending_completion_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "catalog",
        "source_release",
        "source_evidence_index",
        "plan_coverage",
        "source_fixtures"
      ],
      "properties": {
        "plan": {"$ref": "#/$defs/contentRef"},
        "catalog": {"$ref": "#/$defs/contentRef"},
        "source_release": {"$ref": "#/$defs/contentRef"},
        "source_evidence_index": {"$ref": "#/$defs/contentRef"},
        "plan_coverage": {"$ref": "#/$defs/contentRef"},
        "source_fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contentRef"}
        }
      }
    },
    "s0_coverage": {"type": "object"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s0_registry_ready",
        "source_transition_fixture_passed",
        "canonical_source_projection_complete",
        "source_wide_integration_complete",
        "actual_a7_handoff_complete",
        "current_objective_approved",
        "current_run_objective_achieved",
        "personal_profile_pilots_completed",
        "objective_audit_completed",
        "run_outcome_decided",
        "archive_or_continue_executed",
        "live_runtime_verified",
        "nix_generation_build_verified",
        "nix_rebuild_verified",
        "migration_complete",
        "activation_complete",
        "operational_adoption_approved",
        "full_workflow_ready"
      ],
      "properties": {
        "s0_registry_ready": {"const": true},
        "source_transition_fixture_passed": {"const": true},
        "canonical_source_projection_complete": {"const": true},
        "source_wide_integration_complete": {"const": true},
        "actual_a7_handoff_complete": {"const": false},
        "current_objective_approved": {"const": false},
        "current_run_objective_achieved": {"const": false},
        "personal_profile_pilots_completed": {"const": false},
        "objective_audit_completed": {"const": false},
        "run_outcome_decided": {"const": false},
        "archive_or_continue_executed": {"const": false},
        "live_runtime_verified": {"const": false},
        "nix_generation_build_verified": {"const": false},
        "nix_rebuild_verified": {"const": false},
        "migration_complete": {"const": false},
        "activation_complete": {"const": false},
        "operational_adoption_approved": {"const": false},
        "full_workflow_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^(agent-workflows|docs)/"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "planned", "remaining_ids"],
      "properties": {
        "accepted": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 1},
        "remaining_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
