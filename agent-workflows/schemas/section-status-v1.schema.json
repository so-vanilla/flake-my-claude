{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "section-status-v1.schema.json",
  "title": "Source-only section status and separated claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "section_id", "status", "group", "epoch", "ready", "head", "claims", "transition_evidence"],
  "properties": {
    "schema": {"const": "section-status/v1"},
    "section_id": {"type": "string", "pattern": "^S[0-9]+$"},
    "status": {"type": "string", "minLength": 1},
    "group": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["open", "closed"]}, "next_group": {"type": ["string", "null"]}, "bundle_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "artifact-bundle"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "checkpoint_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "checkpoint"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "closed_at_revision": {"type": "integer", "minimum": 1}, "clear_required": {"type": "boolean"}}},
    "epoch": {"type": "object", "additionalProperties": false, "required": ["id", "status", "group_id", "boundary_reason", "clear_before_next"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["open", "closed"]}, "group_id": {"type": "string", "minLength": 1}, "boundary_reason": {"type": "string", "minLength": 1}, "clear_before_next": {"type": "boolean"}, "input_bundle": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "bundle_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "artifact-bundle"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "checkpoint_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "checkpoint"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "closed_at_revision": {"type": "integer", "minimum": 1}}},
    "ready": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"}},
    "head": {"type": "object", "additionalProperties": false, "required": ["revision", "transaction_digest"], "properties": {"schema": {"const": "dag-head/v1"}, "run_id": {"type": "string", "minLength": 1}, "workflow_version": {"type": "string", "minLength": 1}, "graph_version": {"const": "artifact-task-dag/v1"}, "role": {"const": "orchestrator"}, "revision": {"type": "integer", "minimum": 0}, "state_revision": {"type": "integer", "minimum": 0}, "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["source_transition_fixture_passed", "actual_a7", "activation", "full_ready"], "properties": {"source_transition_fixture_passed": {"type": "boolean"}, "actual_a7": {"const": false}, "activation": {"const": false}, "full_ready": {"const": false}}},
    "transition_evidence": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["pending", "accepted"]}, "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "head": {"type": "object", "additionalProperties": false, "required": ["revision", "transaction_digest"], "properties": {"revision": {"type": "integer", "minimum": 0}, "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}},
    "section_history": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["position", "section_id", "accepted_receipt_ref", "bundle_ref", "checkpoint_ref"], "properties": {"position": {"type": "integer", "minimum": 0}, "section_id": {"type": "string", "pattern": "^S[0-9]+$"}, "accepted_receipt_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "artifact"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "bundle_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "artifact-bundle"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}, "checkpoint_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "checkpoint"}, "path": {"type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json$"}}}}}}
  },
  "oneOf": [
    {"properties": {"section_id": {"const": "S0"}, "section_history": {"type": "array", "maxItems": 0, "items": {}}}},
    {"required": ["section_history"], "properties": {"section_id": {"type": "string", "pattern": "^S[1-9][0-9]*$"}, "section_history": {"type": "array", "minItems": 1, "items": {}}}}
  ]
}
