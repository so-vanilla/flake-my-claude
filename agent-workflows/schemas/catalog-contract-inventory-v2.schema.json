{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-contract-inventory-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_source", "catalog_digest", "current_lineage"],
  "properties": {
    "schema": {"const": "catalog-contract-inventory/v2"},
    "catalog_source": {"const": "docs/plans/ai-agent-workflow-step-catalog.md"},
    "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "current_lineage": {"$ref": "#/$defs/contentRef"}
  },
  "$defs": {
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"const": "agent-workflows/evidence/current-canonical-lineage.json"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
