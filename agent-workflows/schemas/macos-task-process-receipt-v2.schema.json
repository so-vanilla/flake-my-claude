{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macos-task-process-receipt-v2.schema.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?/).+[^/]$"},
    "state_writer_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer",
        "task_child_is_writer",
        "broker_state_root",
        "task_write_roots",
        "task_write_scope_disjoint",
        "descriptor_anchored",
        "no_follow",
        "device_inode_revalidated",
        "pre_post_attachment_checks",
        "rollback",
        "arbitrary_same_uid_atomicity",
        "publication_sigkill_atomicity"
      ],
      "properties": {
        "writer": {"const": "trusted-same-uid-parent"},
        "task_child_is_writer": {"const": false},
        "broker_state_root": {"$ref": "#/$defs/absolute_path"},
        "task_write_roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
        "task_write_scope_disjoint": {"const": true},
        "descriptor_anchored": {"const": true},
        "no_follow": {"const": true},
        "device_inode_revalidated": {"const": true},
        "pre_post_attachment_checks": {"const": true},
        "rollback": {"const": "defense-in-depth"},
        "arbitrary_same_uid_atomicity": {"const": false},
        "publication_sigkill_atomicity": {"const": false}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "broker_id",
    "e2_package_digest",
    "execution_closure_ref",
    "command_identity",
    "process_identity",
    "sandbox_identity",
    "declared_roots",
    "operations",
    "terminal_receipt_digest",
    "os_isolation_enforced",
    "enforcement",
    "caller_observations_accepted",
    "threat_profile",
    "threat_profile_digest",
    "state_writer_boundary",
    "limitations_acknowledged",
    "receipt_digest",
    "broker_mac"
  ],
  "properties": {
    "schema": {"const": "macos-task-process-receipt/v2"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "broker_id": {"$ref": "#/$defs/digest"},
    "e2_package_digest": {"$ref": "#/$defs/digest"},
    "execution_closure_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "command_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "argv_digest", "cwd", "environment_digest"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "argv_digest": {"$ref": "#/$defs/digest"},
        "cwd": {"$ref": "#/$defs/absolute_path"},
        "environment_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "process_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "process_group_id", "birth_token", "boot_identity"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "process_group_id": {"type": "integer", "minimum": 1},
        "birth_token": {"type": "string", "minLength": 1},
        "boot_identity": {"type": "string", "minLength": 1}
      }
    },
    "sandbox_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "profile_imports", "profile_digest", "release_digest"],
      "properties": {
        "engine": {"const": "/usr/bin/sandbox-exec"},
        "profile_imports": {"const": ["dyld-support.sb"]},
        "profile_digest": {"$ref": "#/$defs/digest"},
        "release_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "declared_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "system", "runtime", "write"],
      "properties": {
        "project": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
        "system": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
        "runtime": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
        "write": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}}
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "path", "expected", "result", "exit_code"],
        "properties": {
          "operation": {"enum": ["content-read", "stat", "enumerate"]},
          "path": {"$ref": "#/$defs/absolute_path"},
          "expected": {"enum": ["allowed", "denied"]},
          "result": {"enum": ["allowed", "denied"]},
          "exit_code": {"type": "integer"}
        }
      }
    },
    "terminal_receipt_digest": {"$ref": "#/$defs/digest"},
    "os_isolation_enforced": {"const": true},
    "enforcement": {"const": "macos-positive-read-allow-list"},
    "caller_observations_accepted": {"const": false},
    "threat_profile": {"$ref": "macos-practical-threat-profile-v1.schema.json"},
    "threat_profile_digest": {"const": "sha256:81d2c7823b100e00f3d68e8f2c0877507064ffdc6e935f822130510106cfc955"},
    "state_writer_boundary": {"$ref": "#/$defs/state_writer_boundary"},
    "limitations_acknowledged": {"const": true},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "broker_mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
