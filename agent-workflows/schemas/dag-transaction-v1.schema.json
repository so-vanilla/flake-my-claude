{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dag-transaction-v1.schema.json",
  "title": "Immutable parent-linked DAG transaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kernel_version", "run_id", "workflow_version", "graph_version", "revision", "state_revision", "parent", "command", "command_digest", "idempotency_digest", "state", "object_refs", "compiler_version", "graph_delta", "digest"],
  "properties": {
    "schema": {"const": "dag-transaction/v1"},
    "kernel_version": {"type": "string"},
    "run_id": {"type": "string"},
    "workflow_version": {"type": "string"},
    "graph_version": {"const": "artifact-task-dag/v1"},
    "revision": {"type": "integer", "minimum": 1},
    "state_revision": {"type": "integer", "minimum": 1},
    "parent": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["revision", "transaction_digest"], "properties": {"revision": {"type": "integer", "minimum": 1}, "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}]},
    "command": {"$ref": "dag-command-v1.schema.json"},
    "command_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "idempotency_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"type": "object"},
    "object_refs": {"type": "object"},
    "compiler_version": {"type": "string"},
    "graph_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "added_nodes", "removed_nodes", "added_edges", "removed_edges", "changed_artifacts", "changed_tasks", "changed_reviews", "changed_findings"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "added_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "removed_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "added_edges": {"type": "array", "items": {"$ref": "dag-edge-v1.schema.json"}},
        "removed_edges": {"type": "array", "items": {"$ref": "dag-edge-v1.schema.json"}},
        "changed_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "changed_tasks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "changed_reviews": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "changed_findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
