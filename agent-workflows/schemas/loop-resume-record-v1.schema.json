{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-resume-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resume_id", "identity", "terminal_ref", "reason", "evidence_ref", "non_authorizing"],
  "properties": {
    "schema": {"const": "loop-resume-record/v1"},
    "resume_id": {"$ref": "#/$defs/id"},
    "identity": {"$ref": "loop-work-identity-v1.schema.json"},
    "terminal_ref": {"$ref": "#/$defs/ref"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_ref": {"$ref": "#/$defs/ref"},
    "non_authorizing": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "anyOf": [{"required": ["id"]}, {"required": ["path"]}]
    }
  }
}
