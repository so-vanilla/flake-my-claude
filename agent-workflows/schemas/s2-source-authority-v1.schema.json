{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2-source-authority-v1.schema.json",
  "title": "Externally issued S2 source authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority_version", "issuer", "workspace", "predecessors", "graph", "authority_successor_seam", "expected_counts", "claim_vector"],
  "properties": {
    "schema": {"const": "s2-source-authority/v1"},
    "authority_version": {"const": "S2-source-authority/v1"},
    "issuer": {"const": "codex-root"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "predecessors": {"$ref": "#/$defs/predecessors"},
    "graph": {"$ref": "#/$defs/graph"},
    "authority_successor_seam": {"$ref": "#/$defs/successor"},
    "expected_counts": {"$ref": "#/$defs/counts"},
    "claim_vector": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!\\.local(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*[A-Za-z0-9]$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false, "required": ["root", "git_head"],
      "properties": {
        "root": {"const": "/Users/shuto-vanilla/repos/github.com/so-vanilla/flake-my-claude-ai-rebuild"},
        "git_head": {"const": "e5b87e08d0730e0f2a2c99c9a4883a172c0078e7"}
      }
    },
    "s0Authority": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"const": "agent-workflows/manifests/s0-source-transition-current-authority.json"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "s1Authority": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"const": "agent-workflows/manifests/s1-source-authority.json"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "rotationReceipt": {
      "type": "object", "additionalProperties": false, "required": ["receipt_id", "digest"],
      "properties": {"receipt_id": {"const": "S2-U-R-U-001"}, "digest": {"const": "sha256:8eeb198dd2a3592733c4e028767ee9d07450ea9a2f3e5df3323260d4268a6fe2"}}
    },
    "predecessors": {
      "type": "object", "additionalProperties": false, "required": ["s0_authority", "s1_authority", "rotation_receipt"],
      "properties": {"s0_authority": {"$ref": "#/$defs/s0Authority"}, "s1_authority": {"$ref": "#/$defs/s1Authority"}, "rotation_receipt": {"$ref": "#/$defs/rotationReceipt"}}
    },
    "graphEntry": {
      "type": "object", "additionalProperties": false, "required": ["id", "ref"],
      "properties": {"id": {"type": "string", "pattern": "^S2-(?:plan|catalog|transaction|artifact-(?:0|A|B|C|D)|result-(?:0|A|B|C|D)|epoch-C-0[12]|section-result|review|validation|bundle|checkpoint|accepted|index|next-S3)$"}, "ref": {"$ref": "#/$defs/ref"}}
    },
    "graph": {
      "type": "object", "additionalProperties": false, "required": ["order", "entries"],
      "properties": {
        "order": {"type": "string", "const": "S2-close-graph/v1"},
        "entries": {"type": "array", "minItems": 23, "maxItems": 23, "uniqueItems": true, "items": {"$ref": "#/$defs/graphEntry"}}
      }
    },
    "successor": {
      "type": "object", "additionalProperties": false, "required": ["direction", "fixed_verifier"],
      "properties": {
        "direction": {"const": "graph->authority->future-fixed-verifier"},
        "fixed_verifier": {
          "type": "object", "additionalProperties": false, "required": ["path", "digest"],
          "properties": {"path": {"const": "agent-workflows/src/ai_agent_workflow/s2_evidence.py"}, "digest": {"$ref": "#/$defs/digest"}}
        }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["named_contracts", "profile_steps"],
      "properties": {
        "named_contracts": {"type": "object", "additionalProperties": false, "required": ["accepted", "total"], "properties": {"accepted": {"const": 29}, "total": {"const": 60}}},
        "profile_steps": {"type": "object", "additionalProperties": false, "required": ["accepted", "total"], "properties": {"accepted": {"const": 0}, "total": {"const": 23}}}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["s2_source_accepted", "overall_status", "current_run_objective_approved", "actual_a7_handoff_complete", "migration_complete", "activation_complete", "source_wide_integration_complete", "full_workflow_ready"],
      "properties": {
        "s2_source_accepted": {"const": true}, "overall_status": {"const": "partial"},
        "current_run_objective_approved": {"const": false}, "actual_a7_handoff_complete": {"const": false},
        "migration_complete": {"const": false}, "activation_complete": {"const": false},
        "source_wide_integration_complete": {"const": false}, "full_workflow_ready": {"const": false}
      }
    }
  }
}
