{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s1-source-authority-v1.schema.json",
  "title": "Externally issued S1 source-only authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "authority_version", "issuer", "fixture", "trusted_schemas", "close_index",
    "accepted_s1_plan", "current_inputs", "s0_parent", "compatibility",
    "contracts", "canonical_findings", "expected_head", "checkpoint",
    "allowed_next_input", "acceptance_test", "claim_vector"
  ],
  "properties": {
    "schema": {"const": "s1-source-authority/v1"},
    "authority_version": {"const": "S1-source-authority/v1"},
    "issuer": {"const": "codex-root"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "run_id", "group_id", "execution_class"],
      "properties": {
        "section_id": {"const": "S1"},
        "run_id": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "execution_class": {"const": "source-only"}
      }
    },
    "trusted_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_review", "finding_validation", "section_bundle", "accepted_result", "s1_authority"],
      "properties": {
        "section_review": {"$ref": "#/$defs/ref"},
        "finding_validation": {"$ref": "#/$defs/ref"},
        "section_bundle": {"$ref": "#/$defs/ref"},
        "accepted_result": {"$ref": "#/$defs/ref"},
        "s1_authority": {"$ref": "#/$defs/ref"}
      }
    },
    "close_index": {"$ref": "#/$defs/ref"},
    "accepted_s1_plan": {"$ref": "#/$defs/ref"},
    "current_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_implementation_plan", "step_catalog"],
      "properties": {
        "full_implementation_plan": {"$ref": "#/$defs/ref"},
        "step_catalog": {"$ref": "#/$defs/ref"}
      }
    },
    "s0_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "result", "bundle", "checkpoint"],
      "properties": {
        "index": {"$ref": "#/$defs/ref"},
        "result": {"$ref": "#/$defs/ref"},
        "bundle": {"$ref": "#/$defs/ref"},
        "checkpoint": {"$ref": "#/$defs/ref"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "plan", "manifest", "authority", "verifier"],
      "properties": {
        "evidence": {"$ref": "#/$defs/ref"},
        "plan": {"$ref": "#/$defs/ref"},
        "manifest": {"$ref": "#/$defs/ref"},
        "authority": {"$ref": "#/$defs/ref"},
        "verifier": {"$ref": "#/$defs/ref"}
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group.A.A1", "group.A.A2", "group.A.A3", "group.A.A4",
        "group.A.A5", "group.A.A6", "group.A.A6R", "group.A.A7",
        "group.F.F1", "group.F.F2", "group.F.F3", "group.F.F4",
        "group.F.F5", "group.F.F6", "group.F.F7", "group.F.F8"
      ],
      "properties": {
        "group.A.A1": {"$ref": "#/$defs/contractBinding"},
        "group.A.A2": {"$ref": "#/$defs/contractBinding"},
        "group.A.A3": {"$ref": "#/$defs/contractBinding"},
        "group.A.A4": {"$ref": "#/$defs/contractBinding"},
        "group.A.A5": {"$ref": "#/$defs/contractBinding"},
        "group.A.A6": {"$ref": "#/$defs/contractBinding"},
        "group.A.A6R": {"$ref": "#/$defs/contractBinding"},
        "group.A.A7": {"$ref": "#/$defs/contractBinding"},
        "group.F.F1": {"$ref": "#/$defs/contractBinding"},
        "group.F.F2": {"$ref": "#/$defs/contractBinding"},
        "group.F.F3": {"$ref": "#/$defs/contractBinding"},
        "group.F.F4": {"$ref": "#/$defs/contractBinding"},
        "group.F.F5": {"$ref": "#/$defs/contractBinding"},
        "group.F.F6": {"$ref": "#/$defs/contractBinding"},
        "group.F.F7": {"$ref": "#/$defs/contractBinding"},
        "group.F.F8": {"$ref": "#/$defs/contractBinding"}
      }
    },
    "canonical_findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/finding"}
    },
    "expected_head": {"$ref": "#/$defs/head"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "digest"],
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "allowed_next_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "ref"],
      "properties": {
        "identity": {"const": "next-S2"},
        "ref": {"$ref": "#/$defs/ref"}
      }
    },
    "acceptance_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "tests_run", "exit_status", "status"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "tests_run": {"type": "integer", "minimum": 1},
        "exit_status": {"const": 0},
        "status": {"const": "passed"}
      }
    },
    "claim_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s0_registry_ready", "source_transition_fixture_passed",
        "s1_bootstrap_shared_lifecycle_source_complete", "named_contracts",
        "profile_steps", "actual_a7_handoff_complete", "migration_complete",
        "activation_complete", "source_wide_integration_complete",
        "full_workflow_ready"
      ],
      "properties": {
        "s0_registry_ready": {"const": true},
        "source_transition_fixture_passed": {"const": true},
        "s1_bootstrap_shared_lifecycle_source_complete": {"const": true},
        "named_contracts": {"$ref": "#/$defs/namedCount"},
        "profile_steps": {"$ref": "#/$defs/profileCount"},
        "actual_a7_handoff_complete": {"const": false},
        "migration_complete": {"const": false},
        "activation_complete": {"const": false},
        "source_wide_integration_complete": {"const": false},
        "full_workflow_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!\\.local(?:/|$))(?!.*\\/\\.local(?:/|$))(?!.*(?:^|/)s1_evidence\\.py$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*[A-Za-z0-9]$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "evidence", "selector"],
      "properties": {
        "source": {"$ref": "#/$defs/ref"},
        "evidence": {"$ref": "#/$defs/ref"},
        "selector": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "state", "attempts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "state": {"enum": ["closed", "defer", "reject"]},
        "attempts": {
          "type": "array", "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "integer", "enum": [1, 2, 3, 4, 5]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "closed"}}},
          "then": {"properties": {"attempts": {"minItems": 1}}},
          "else": {"properties": {"attempts": {"maxItems": 0}}}
        }
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "transaction_digest"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "transaction_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "namedCount": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted", "total"],
      "properties": {"accepted": {"const": 16}, "total": {"const": 60}}
    },
    "profileCount": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted", "total"],
      "properties": {"accepted": {"const": 0}, "total": {"const": 23}}
    }
  }
}
