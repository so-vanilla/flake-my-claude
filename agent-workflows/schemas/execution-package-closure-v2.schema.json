{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-package-closure-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "contract_version", "workspace_identity", "candidate_ref", "test_refs", "fixture_refs", "schema_refs", "config_refs", "lock_refs", "toolchain", "command", "environment", "isolation", "resource_claims", "supervision", "external_input_refs", "closure_digest"],
  "properties": {
    "schema": {"const": "execution-package-closure/v2"},
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "contract_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "workspace_identity": {"type": "string", "pattern": "^/(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?/).+[^/]$"},
    "candidate_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "test_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "fixture_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "schema_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "config_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "lock_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["executable_digest", "identity"], "properties": {"executable_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "identity": {"type": "string", "minLength": 1}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["argv", "cwd"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd": {"type": "string", "minLength": 1}}},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["cwd", "temporary_namespace", "output_namespace"], "properties": {"cwd": {"type": "string", "minLength": 1}, "temporary_namespace": {"type": "string", "minLength": 1}, "output_namespace": {"type": "string", "minLength": 1}}},
    "resource_claims": {"type": "object", "additionalProperties": false, "required": ["read_paths", "write_paths", "exclusive_resources"], "properties": {"read_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "write_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "exclusive_resources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "supervision": {"type": "object", "additionalProperties": false, "required": ["timeout_seconds", "grace_seconds", "signals", "heartbeat_seconds", "terminal_publication_seconds"], "properties": {"timeout_seconds": {"type": "integer", "minimum": 1}, "grace_seconds": {"type": "integer", "minimum": 1}, "signals": {"type": "array", "minItems": 1, "items": {"enum": ["TERM", "KILL", "INT"]}}, "heartbeat_seconds": {"type": "integer", "minimum": 1}, "terminal_publication_seconds": {"type": "integer", "minimum": 1}}},
    "external_input_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
