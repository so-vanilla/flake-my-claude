{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a7-self-host-status-v1.schema.json",
  "title": "Fresh-reader A7 handoff status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "workflow_version", "objective_ref", "manual_state_revision", "manual_epoch_closed_at_revision", "kernel_state_revision", "checkpoint_id", "manifest_digest", "next_group_can_begin", "next_group", "rollback_point", "head"],
  "properties": {
    "schema": {"const": "a7-self-host-status/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_version": {"type": "string", "minLength": 1},
    "objective_ref": {"type": "object", "minProperties": 1},
    "manual_state_revision": {"type": "integer", "minimum": 1},
    "manual_epoch_closed_at_revision": {"type": "integer", "minimum": 1},
    "kernel_state_revision": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "next_group_can_begin": {"type": "boolean"},
    "next_group": {"type": ["string", "null"]},
    "rollback_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_head_before_handoff", "legacy_source_revision", "manual_checkpoint_id"],
      "properties": {
        "kernel_head_before_handoff": {"type": "object"},
        "legacy_source_revision": {"type": "integer", "minimum": 1},
        "manual_checkpoint_id": {"type": "string", "minLength": 1}
      }
    },
    "head": {"type": "object"}
  }
}
