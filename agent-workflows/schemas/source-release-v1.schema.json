{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-release-v1.schema.json",
  "title": "Deterministic source-only release projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_only",
    "compiler",
    "authority",
    "inputs",
    "coverage",
    "evidence_index",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "source-release/v1"
    },
    "source_only": {
      "const": true
    },
    "compiler": {
      "$ref": "#/$defs/ref"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "step_catalog"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/ref"
        },
        "step_catalog": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "schemas",
        "group_manifests",
        "profile_manifests",
        "workflow_manifests",
        "surface_manifest"
      ],
      "properties": {
        "catalog": {
          "$ref": "#/$defs/ref"
        },
        "schemas": {
          "$ref": "#/$defs/refs"
        },
        "group_manifests": {
          "$ref": "#/$defs/refs"
        },
        "profile_manifests": {
          "$ref": "#/$defs/refs"
        },
        "workflow_manifests": {
          "$ref": "#/$defs/refs"
        },
        "surface_manifest": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "named_contracts",
        "profile_steps",
        "additional_required_surfaces"
      ],
      "properties": {
        "named_contracts": {
          "$ref": "#/$defs/catalog_coverage"
        },
        "profile_steps": {
          "$ref": "#/$defs/catalog_coverage"
        },
        "additional_required_surfaces": {
          "$ref": "#/$defs/manifest_coverage"
        }
      }
    },
    "evidence_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "owner",
        "entry_count",
        "entries_digest"
      ],
      "properties": {
        "path": {
          "const": "agent-workflows/manifests/source-evidence-index.json"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "owner": {
          "const": "source-release/v1"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source_projection_complete",
        "source_wide_integration_complete",
        "actual_a7_handoff_complete",
        "current_objective_approved",
        "current_run_objective_achieved",
        "nix_rebuild_verified",
        "migration_complete",
        "activation_complete",
        "full_workflow_ready"
      ],
      "properties": {
        "canonical_source_projection_complete": {
          "const": true
        },
        "source_wide_integration_complete": {
          "const": false
        },
        "actual_a7_handoff_complete": {
          "const": false
        },
        "current_objective_approved": {
          "const": false
        },
        "current_run_objective_achieved": {
          "const": false
        },
        "nix_rebuild_verified": {
          "const": false
        },
        "migration_complete": {
          "const": false
        },
        "activation_complete": {
          "const": false
        },
        "full_workflow_ready": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(agent-workflows|docs)/"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "catalog_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_total",
        "manifest_total",
        "accepted",
        "complete"
      ],
      "properties": {
        "catalog_total": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_total": {
          "type": "integer",
          "minimum": 1
        },
        "accepted": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "const": true
        }
      }
    },
    "manifest_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_total",
        "accepted",
        "complete"
      ],
      "properties": {
        "manifest_total": {
          "type": "integer",
          "minimum": 1
        },
        "accepted": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "const": true
        }
      }
    }
  }
}
