{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "section-transition-compatibility-authority-v1.schema.json",
  "title": "Fixed external authority for S0 to S1 compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_id",
    "issuer",
    "compatibility_id",
    "version",
    "fixture",
    "workspace_git_head",
    "expected_head",
    "manifest",
    "evidence",
    "sources",
    "schemas",
    "inputs",
    "s0_close",
    "test_receipts",
    "review_validation_history",
    "claims"
  ],
  "properties": {
    "schema": {"const": "section-transition-compatibility-authority/v1"},
    "authority_id": {"type": "string", "minLength": 1},
    "issuer": {"const": "codex-root"},
    "compatibility_id": {"const": "S0-S1-TRANSITION"},
    "version": {"const": "v1"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "workspace_git_head": {"$ref": "#/$defs/git_head"},
    "expected_head": {"$ref": "#/$defs/head"},
    "manifest": {"$ref": "#/$defs/ref"},
    "evidence": {"$ref": "#/$defs/ref"},
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/source"}
    },
    "schemas": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/named_ref"}
    },
    "inputs": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/ref"}
    },
    "s0_close": {"$ref": "#/$defs/s0_close"},
    "test_receipts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/test_receipt"}
    },
    "review_validation_history": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/review_record"}
    },
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[.A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "named_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "digest"],
      "properties": {
        "role": {"enum": ["compiler", "kernel", "compatibility-test"]},
        "path": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "transaction_digest", "synthetic"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "transaction_digest": {"$ref": "#/$defs/digest"},
        "synthetic": {"type": "boolean", "const": true}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "public_interface", "predecessor", "target_rule"],
      "properties": {
        "kind": {"const": "source-only"},
        "public_interface": {"const": "section-control-plane/v1"},
        "predecessor": {"const": "accepted-section"},
        "target_rule": {"const": "numeric-immediate-successor"}
      }
    },
    "s0_close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "accepted_parent_receipt"],
      "properties": {
        "index": {"$ref": "#/$defs/ref"},
        "accepted_parent_receipt": {"$ref": "#/$defs/ref"}
      }
    },
    "test_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "command", "tests_run", "exit_status", "status"],
      "properties": {
        "scope": {"enum": ["focused", "affected-regression", "full-suite"]},
        "command": {"type": "string", "minLength": 1},
        "tests_run": {"type": "integer", "minimum": 1},
        "exit_status": {"type": "integer", "const": 0},
        "status": {"const": "passed"}
      }
    },
    "review_record": {
      "oneOf": [
        {"$ref": "#/$defs/u_a_or_u_b_review_record"},
        {"$ref": "#/$defs/u_c_review_record"}
      ]
    },
    "u_a_or_u_b_review_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "candidate_digest",
        "closure_validation",
        "verdict",
        "required_open",
        "needs_user",
        "test_evidence_debt"
      ],
      "properties": {
        "unit": {"enum": ["U-A", "U-B"]},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "closure_validation": {"$ref": "#/$defs/ref"},
        "verdict": {"const": "accepted"},
        "required_open": {"type": "integer", "const": 0},
        "needs_user": {"type": "integer", "const": 0},
        "test_evidence_debt": {"type": "integer", "const": 0}
      }
    },
    "u_c_review_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "candidate_digest",
        "closure_security",
        "closure_coverage",
        "closure_validation",
        "verdict",
        "required_open",
        "needs_user",
        "test_evidence_debt"
      ],
      "properties": {
        "unit": {"const": "U-C"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "closure_security": {"$ref": "#/$defs/ref"},
        "closure_coverage": {"$ref": "#/$defs/ref"},
        "closure_validation": {"$ref": "#/$defs/ref"},
        "verdict": {"const": "accepted"},
        "required_open": {"type": "integer", "const": 0},
        "needs_user": {"type": "integer", "const": 0},
        "test_evidence_debt": {"type": "integer", "const": 0}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_transition_fixture_passed",
        "actual_a7",
        "migration",
        "activation",
        "full_ready",
        "accepted_named",
        "named_targets",
        "accepted_profiles",
        "profile_targets"
      ],
      "properties": {
        "source_transition_fixture_passed": {"type": "boolean", "const": true},
        "actual_a7": {"type": "boolean", "const": false},
        "migration": {"type": "boolean", "const": false},
        "activation": {"type": "boolean", "const": false},
        "full_ready": {"type": "boolean", "const": false},
        "accepted_named": {"type": "integer", "const": 3},
        "named_targets": {"type": "integer", "const": 60},
        "accepted_profiles": {"type": "integer", "const": 0},
        "profile_targets": {"type": "integer", "const": 23}
      }
    }
  }
}
