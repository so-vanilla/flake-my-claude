{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "section-schedule-v1.schema.json", "title": "Deterministic section schedule", "type": "object", "additionalProperties": false,
  "required": ["schema", "section_id", "workflow_id", "groups", "first_frontier"],
  "properties": {
    "schema": {"const": "section-schedule/v1"}, "section_id": {"type": "string", "pattern": "^S[0-9]+$"}, "workflow_id": {"type": "string", "minLength": 1},
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "first_epoch", "first_frontier"], "properties": {"id": {"type": "string", "minLength": 1}, "first_epoch": {"type": "string", "minLength": 1}, "first_frontier": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"}}}}},
    "first_frontier": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]+\\.[A-Za-z][A-Za-z0-9_-]*$"}}
  }
}
