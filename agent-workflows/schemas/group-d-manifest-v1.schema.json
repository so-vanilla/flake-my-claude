    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.D.D3"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.D.D4"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.D.D5"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.D.D6"}}, "required": ["qualified_id"]}}}},
