    "contract_base": {"type": "object", "additionalProperties": false, "required": ["qualified_id", "local_id", "status", "source_ref", "selector_ref", "receipt_ref"], "properties": {"qualified_id": {"enum": ["group.D.D1", "group.D.D2", "group.D.D3", "group.D.D4", "group.D.D5", "group.D.D6", "group.D.D7", "group.D.D8", "group.D.D9", "group.D.D10", "group.D.D11", "group.D.D12"]}, "local_id": {"enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11", "D12"]}, "status": {"const": "candidate-source"}, "source_ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^agent-workflows/skills/[a-z0-9-]+/SKILL\\.md$"}, "digest": {"$ref": "#/$defs/digest"}}}, "selector_ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "selector"], "properties": {"path": {"const": "agent-workflows/src/ai_agent_workflow/planning_system.py"}, "digest": {"$ref": "#/$defs/digest"}, "selector": {"enum": ["PlanningSystemV1.compile(group.D.D1)", "PlanningSystemV1.compile(group.D.D2)", "PlanningSystemV1.compile(group.D.D3)", "PlanningSystemV1.compile(group.D.D4)", "PlanningSystemV1.compile(group.D.D5)", "PlanningSystemV1.compile(group.D.D6)", "PlanningSystemV1.compile(group.D.D7)", "PlanningSystemV1.compile(group.D.D8)", "PlanningSystemV1.compile(group.D.D9)", "PlanningSystemV1.compile(group.D.D10)", "PlanningSystemV1.compile(group.D.D11)", "PlanningSystemV1.compile(group.D.D12)"]}}}, "receipt_ref": {"$ref": "#/$defs/physical_ref"}}},
    "contract": {"oneOf": [
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D1"}, "local_id": {"const": "D1"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/select-workflow-profile/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D1)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D1.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D2"}, "local_id": {"const": "D2"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/reverse-engineer-current-system/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D2)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D2.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D3"}, "local_id": {"const": "D3"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/discover-practices/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D3)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D3.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D4"}, "local_id": {"const": "D4"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/specify-what-and-why/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D4)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D4.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D5"}, "local_id": {"const": "D5"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/explore-options/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D5)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D5.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D6"}, "local_id": {"const": "D6"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/design-solution/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D6)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D6.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D7"}, "local_id": {"const": "D7"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/design-contracts/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D7)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D7.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D8"}, "local_id": {"const": "D8"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/decompose-tasks/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D8)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D8.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D9"}, "local_id": {"const": "D9"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/sequence-and-parallelize/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D9)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D9.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D10"}, "local_id": {"const": "D10"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/prepare-worker-briefs/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D10)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D10.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D11"}, "local_id": {"const": "D11"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/plan-verification-and-recovery/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D11)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D11.json"}}}}}]},
      {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.D.D12"}, "local_id": {"const": "D12"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/implementation-readiness-review/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "PlanningSystemV1.compile(group.D.D12)"}}}, "receipt_ref": {"properties": {"path": {"const": "agent-workflows/evidence/contracts/D12.json"}}}}}]}
    ]}
  }
}
