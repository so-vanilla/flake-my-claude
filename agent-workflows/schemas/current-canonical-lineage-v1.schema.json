{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-canonical-lineage-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lineage_id", "version", "predecessor_authority", "canonical_inputs", "implementation_status", "corrected_candidate"],
  "properties": {
    "schema": {"const": "current-canonical-lineage/v1"},
    "lineage_id": {"const": "ai-agent-workflow-current-canonical-lineage-v2"},
    "version": {"const": "v2"},
    "predecessor_authority": {"$ref": "#/$defs/contentRef"},
    "canonical_inputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/roleRef"}
    },
    "implementation_status": {"$ref": "#/$defs/contentRef"},
    "corrected_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "records"],
      "properties": {
        "aggregate": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "records": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {"$ref": "#/$defs/contentRef"}
        }
      }
    }
  },
  "$defs": {
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^[.A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "roleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "digest"],
      "properties": {
        "role": {"enum": ["rebuild-plan", "step-catalog", "full-implementation-plan"]},
        "path": {"type": "string", "pattern": "^[.A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
