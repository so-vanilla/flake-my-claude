{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-report/v1",
  "title": "Independent worker report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "worker_id",
    "run_id",
    "context_epoch",
    "group_id",
    "objective_ref",
    "artifact_refs",
    "verification",
    "unresolved_items",
    "status"
  ],
  "properties": {
    "schema": { "const": "worker-report/v1" },
    "worker_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "context_epoch": { "type": "string", "minLength": 1 },
    "group_id": { "type": "string", "minLength": 1 },
    "objective_ref": { "type": "object" },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "version", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": { "type": "array" },
    "unresolved_items": { "type": "array" },
    "status": { "enum": ["completed", "blocked", "needs_decision"] }
  }
}
