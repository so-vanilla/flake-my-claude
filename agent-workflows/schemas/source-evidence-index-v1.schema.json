{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-evidence-index-v1.schema.json",
  "title": "Canonical source-only evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "ordering",
    "entry_count",
    "entries",
    "entries_digest"
  ],
  "properties": {
    "schema": {
      "const": "source-evidence-index/v1"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "compiler"
      ],
      "properties": {
        "id": {
          "const": "source-release/v1"
        },
        "path": {
          "const": "agent-workflows/manifests/source-release.json"
        },
        "compiler": {
          "const": "ai_agent_workflow.source_release.SourceReleaseV1"
        }
      }
    },
    "ordering": {
      "const": "catalog-groups-then-catalog-profiles-then-surface-manifest"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "entries_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(agent-workflows|docs)/"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "result"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^agent-workflows/evidence/(contracts|profiles|surfaces)/"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "result": {
          "const": "passed"
        }
      }
    },
    "reachability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "group-composition",
            "profile-composition",
            "surface-composition",
            "workflow"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^agent-workflows/(groups|profiles|manifests|workflows)/"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "stage_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "source",
        "test_selector",
        "evidence",
        "reachability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(group\\.[A-H]\\.[A-Z0-9]+|profile\\.(feature|bug-fix|improvement)\\.[A-Z0-9]+|surface\\.)"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "skill",
            "shared-protocol-operation",
            "workflow-profile-step",
            "required-surface"
          ]
        },
        "source": {
          "$ref": "#/$defs/ref"
        },
        "test_selector": {
          "type": "string",
          "pattern": "^agent-workflows/tests/test_[^:]+\\.py::"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reachability": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reachability"
          }
        }
      }
    }
  }
}
