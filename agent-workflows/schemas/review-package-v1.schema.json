{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-package-v1.schema.json",
  "title": "Fresh independent Review package",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "candidate_task_id", "reviewer_assignment_id", "fresh_epoch_id", "review_kind", "target_finding_id", "findings", "candidate_ref", "evidence_refs", "provenance"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "candidate_task_id": {"type": "string", "minLength": 1},
    "reviewer_assignment_id": {"type": "string", "minLength": 1},
    "fresh_epoch_id": {"type": "string", "minLength": 1},
    "review_kind": {"enum": ["initial", "closure"]},
    "target_finding_id": {"type": ["string", "null"]},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["finding_id", "fingerprint", "requirement_ref", "description", "evidence", "severity", "state", "blocking"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "requirement_ref": {}, "description": {"type": "string", "minLength": 1}, "evidence": {"type": "array"}, "severity": {"type": "string", "minLength": 1}, "state": {"const": "open"}, "blocking": {"type": "boolean"}}}},
    "candidate_ref": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"const": "task-package"}, "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\*)(?!.*\\/$).+$"}}},
    "evidence_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["digest"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\*)(?!.*\\/$).+$"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["candidate_package_digest", "evidence_digests", "review_epoch_id", "reviewer_assignment_id"], "properties": {"candidate_package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "evidence_digests": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "review_epoch_id": {"type": "string", "minLength": 1}, "reviewer_assignment_id": {"type": "string", "minLength": 1}}}
  }
}
