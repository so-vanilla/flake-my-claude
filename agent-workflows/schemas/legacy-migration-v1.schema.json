{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legacy-migration-v1.schema.json",
  "title": "A6 to A6R fixture migration record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "source_digests", "source_bindings", "source_snapshot", "source_refs", "source_attestation", "field_mapping", "history_preserved", "cutover_status"],
  "properties": {
    "schema": {"const": "legacy-migration/v1"},
    "source_revision": {"type": "integer", "minimum": 1},
    "source_digests": {"type": "object", "additionalProperties": false, "required": ["run", "bundle", "worker_report"], "properties": {"run": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bundle": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "worker_report": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "source_bindings": {"type": "object", "additionalProperties": false, "required": ["source_run_id", "group_id", "epoch_id", "aliases", "source_revision", "run_status", "source_status", "epoch_status"], "properties": {"source_run_id": {"type": "string", "minLength": 1}, "group_id": {"type": "string", "minLength": 1}, "epoch_id": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}, "source_revision": {"type": "integer", "minimum": 1}, "run_status": {"enum": ["open", "closed"]}, "source_status": {"type": "string", "minLength": 1}, "epoch_status": {"const": "closed"}}},
    "source_snapshot": {"type": "object", "additionalProperties": false, "required": ["mode", "source_digests", "source_bindings"], "properties": {"mode": {"const": "immutable"}, "source_digests": {"type": "object", "additionalProperties": false, "required": ["run", "bundle", "worker_report"], "properties": {"run": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bundle": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "worker_report": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "source_bindings": {"type": "object", "additionalProperties": false, "required": ["source_run_id", "group_id", "epoch_id", "aliases", "source_revision", "run_status", "source_status", "epoch_status"], "properties": {"source_run_id": {"type": "string", "minLength": 1}, "group_id": {"type": "string", "minLength": 1}, "epoch_id": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}, "source_revision": {"type": "integer", "minimum": 1}, "run_status": {"enum": ["open", "closed"]}, "source_status": {"type": "string", "minLength": 1}, "epoch_status": {"const": "closed"}}}}},
    "source_refs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["digest", "object_type", "path"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_type": {"enum": ["legacy-run", "legacy-bundle", "legacy-worker-report"]}, "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\*)(?!.*\\/$).+$"}}}},
    "source_attestation": {"type": "object", "additionalProperties": false, "required": ["run", "bundle", "worker_report"], "properties": {"run": {"type": "object", "additionalProperties": false, "required": ["path", "raw_digest", "value_digest"], "properties": {"path": {"type": "string", "pattern": "^/(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*\\/$).+$"}, "raw_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "value_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "bundle": {"type": "object", "additionalProperties": false, "required": ["path", "raw_digest", "value_digest"], "properties": {"path": {"type": "string", "pattern": "^/(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*\\/$).+$"}, "raw_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "value_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "worker_report": {"type": "object", "additionalProperties": false, "required": ["path", "raw_digest", "value_digest"], "properties": {"path": {"type": "string", "pattern": "^/(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*\\/$).+$"}, "raw_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "value_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}},
    "field_mapping": {"type": "object"},
    "history_preserved": {"const": true},
    "cutover_status": {"enum": ["candidate", "cutover", "rolled_back"]}
  }
}
