{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "evidence-finalization-v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema", "candidate_ref", "execution_closure_digest", "receipt_aggregate_ref", "finding_disposition_ref", "declared_branch_inventory_ref", "branches", "acceptance", "finalization_digest"],
  "properties": {
    "schema": {"const": "evidence-finalization/v1"}, "candidate_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "execution_closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_aggregate_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "finding_disposition_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "declared_branch_inventory_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "branches": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["branch_id", "state", "complete", "terminal_ref"], "properties": {"branch_id": {"type": "string", "minLength": 1}, "state": {"const": "accepted"}, "complete": {"const": true}, "terminal_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["known", "complete", "accepted"], "properties": {"known": {"const": true}, "complete": {"const": true}, "accepted": {"const": true}}}, "finalization_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
