{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-review-assessment-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_id", "axis", "actor_id", "context_epoch", "candidate_digest", "package_digest", "coverage", "completed", "unevaluated", "finding_refs"],
  "properties": {
    "schema": {"const": "loop-review-assessment/v1"},
    "review_id": {"type": "string", "minLength": 1},
    "axis": {"enum": ["architecture-safety", "integration-operability"]},
    "actor_id": {"type": "string", "minLength": 1},
    "context_epoch": {"type": "string", "minLength": 1},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "package_digest": {"$ref": "#/$defs/digest"},
    "coverage": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "completed": {"type": "boolean"},
    "unevaluated": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "finding_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["digest"],
      "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}},
      "anyOf": [{"required": ["id"]}, {"required": ["path"]}]
    }
  }
}
