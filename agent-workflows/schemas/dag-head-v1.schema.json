{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dag-head-v1.schema.json",
  "title": "Atomic canonical HEAD pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "workflow_version", "graph_version", "role", "revision", "state_revision", "transaction_digest", "digest"],
  "properties": {
    "schema": {"const": "dag-head/v1"},
    "run_id": {"type": "string"},
    "workflow_version": {"type": "string"},
    "graph_version": {"const": "artifact-task-dag/v1"},
    "role": {"const": "orchestrator"},
    "revision": {"type": "integer", "minimum": 1},
    "state_revision": {"type": "integer", "minimum": 1},
    "transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
