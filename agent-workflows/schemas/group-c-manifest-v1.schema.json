{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group-c-manifest-v1.schema.json",
  "title": "Strict physical Group C Skill contract manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "group_id", "implementation_kind", "contracts"],
  "properties": {
    "schema": {"const": "group-c-manifest/v1"},
    "group_id": {"const": "agent-workflows.group.C"},
    "implementation_kind": {"const": "skill"},
    "contracts": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/contract"}}
  },
  "allOf": [
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.C.C1"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.C.C2"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.C.C3"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.C.C4"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.C.C5"}}, "required": ["qualified_id"]}}}},
    {"properties": {"contracts": {"contains": {"properties": {"qualified_id": {"const": "group.C.C6"}}, "required": ["qualified_id"]}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "physical_ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^agent-workflows/.+"}, "digest": {"$ref": "#/$defs/digest"}}},
    "contract": {"oneOf": [{"$ref": "#/$defs/c1_contract"}, {"$ref": "#/$defs/c2_contract"}, {"$ref": "#/$defs/c3_contract"}, {"$ref": "#/$defs/c4_contract"}, {"$ref": "#/$defs/c5_contract"}, {"$ref": "#/$defs/c6_contract"}]},
    "contract_base": {"type": "object", "additionalProperties": false, "required": ["qualified_id", "local_id", "status", "source_ref", "selector_ref", "receipt_ref"], "properties": {"qualified_id": {"enum": ["group.C.C1", "group.C.C2", "group.C.C3", "group.C.C4", "group.C.C5", "group.C.C6"]}, "local_id": {"enum": ["C1", "C2", "C3", "C4", "C5", "C6"]}, "status": {"enum": ["candidate-source", "retained-accepted"]}, "source_ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^agent-workflows/skills/[a-z0-9-]+/SKILL\\.md$"}, "digest": {"$ref": "#/$defs/digest"}}}, "selector_ref": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "selector"], "properties": {"path": {"const": "agent-workflows/src/ai_agent_workflow/outcome_system.py"}, "digest": {"$ref": "#/$defs/digest"}, "selector": {"enum": ["OutcomeSystemV1.decompose_outcomes", "OutcomeSystemV1.build_dependency_graph", "OutcomeSystemV1.design_measurement", "OutcomeSystemV1.define_targets", "OutcomeSystemV1.record_baseline", "OutcomeSystemV1.validate_system"]}}}, "receipt_ref": {"$ref": "#/$defs/physical_ref"}}},
    "c1_contract": {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.C.C1"}, "local_id": {"const": "C1"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/decompose-outcomes/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "OutcomeSystemV1.decompose_outcomes"}}}}}]},
    "c2_contract": {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.C.C2"}, "local_id": {"const": "C2"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/build-outcome-dependency-graph/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "OutcomeSystemV1.build_dependency_graph"}}}}}]},
    "c3_contract": {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.C.C3"}, "local_id": {"const": "C3"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/design-measurement/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "OutcomeSystemV1.design_measurement"}}}}}]},
    "c4_contract": {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.C.C4"}, "local_id": {"const": "C4"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/define-targets/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "OutcomeSystemV1.define_targets"}}}}}]},
    "c5_contract": {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.C.C5"}, "local_id": {"const": "C5"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/capture-baseline/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "OutcomeSystemV1.record_baseline"}}}}}]},
    "c6_contract": {"allOf": [{"$ref": "#/$defs/contract_base"}, {"properties": {"qualified_id": {"const": "group.C.C6"}, "local_id": {"const": "C6"}, "source_ref": {"properties": {"path": {"const": "agent-workflows/skills/validate-outcome-system/SKILL.md"}}}, "selector_ref": {"properties": {"selector": {"const": "OutcomeSystemV1.validate_system"}}}}}]}
  }
}
