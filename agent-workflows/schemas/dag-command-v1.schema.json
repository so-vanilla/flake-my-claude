{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dag-command-v1.schema.json",
  "title": "Versioned orchestrator command envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command_id",
    "command_type",
    "run_id",
    "expected_head",
    "workflow_version",
    "graph_version",
    "actor",
    "authority_ref",
    "input_refs",
    "idempotency_key",
    "protected_fields",
    "scope",
    "payload"
  ],
  "properties": {
    "schema": {"const":"dag-command/v1"},
    "command_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"},
    "command_type": {
      "enum": [
        "entry",
        "approve_objective",
        "publish_artifact",
        "publish_task_package",
        "migrate_legacy",
        "accept_task_result",
        "open_review_epoch",
        "open_review",
        "accept_review",
        "validate_findings",
        "terminal_review",
        "reopen_review",
        "accept_resolution_claim",
        "accept_finding_closure",
        "claim_task",
        "release_task",
        "invalidate_task",
        "replan_task",
        "open_epoch",
        "close_epoch",
        "close_group",
        "open_section",
        "open_group",
        "open_operational_group"
      ]
    },
    "run_id": {"type":"string","minLength":1},
    "expected_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision","transaction_digest"],
      "properties": {
        "revision": {"type":"integer","minimum":0},
        "transaction_digest": {"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},
        "digest": {"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"}
      }
    },
    "workflow_version": {"type":["string","null"]},
    "graph_version": {"const":"artifact-task-dag/v1"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role","assignment_id"],
      "properties": {
        "role": {"enum":["controller","worker","reviewer","validator","arbiter","orchestrator"]},
        "assignment_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"}
      }
    },
    "authority_ref": {"type":"object","minProperties":1},
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest"],
        "properties": {
          "kind": {"type":"string","minLength":1},
          "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "object_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "external": {"type":"boolean"},
          "node_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"},
          "artifact_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"},
          "task_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"},
          "object_type": {"type":"string","minLength":1},
          "path": {"type":"string","pattern":"^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\*)(?!.*\\/$).+$"}
        }
      }
    },
    "idempotency_key": {"type":"string","minLength":1},
    "protected_fields": {"type":"array","items":{"type":"string"}},
    "scope": {
      "type": "array",
      "items": {
        "oneOf": [
          {"const":"*"},
          {"type":"string","pattern":"^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\*).+$"},
          {"type":"string","pattern":"^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//).+/\\*$"}
        ]
      }
    },
    "payload": {"type":"object"}
  },
  "oneOf": [
    {
      "required": ["command_type","authority_ref","protected_fields","scope","payload"],
      "properties": {
        "command_type": {"const":"approve_objective"},
        "authority_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status","scopes","run_id","namespace","approval_scope","actor_id","proposal_digest","human_receipt","protected_fields","write_scopes"],
          "properties": {
            "status": {"const":"approved"},
            "scopes": {"type":"array","items":{"const":"approve_objective"},"minItems":1,"maxItems":1},
            "run_id": {"type":"string","minLength":1},
            "namespace": {"$ref":"objective-approval-v1.schema.json#/$defs/namespace"},
            "approval_scope": {"const":"fixture-only"},
            "actor_id": {"type":"string","minLength":1},
            "proposal_digest": {"$ref":"objective-approval-v1.schema.json#/$defs/digest"},
            "human_receipt": {"$ref":"objective-approval-v1.schema.json#/$defs/receipt"},
            "protected_fields": {"type":"array","items":{"const":"objective_ref"},"minItems":1,"maxItems":1},
            "write_scopes": {"type":"array","items":{"$ref":"objective-approval-v1.schema.json#/$defs/namespace"},"minItems":1,"maxItems":1}
          }
        },
        "protected_fields": {"type":"array","items":{"const":"objective_ref"},"minItems":1,"maxItems":1},
        "scope": {"type":"array","items":{"$ref":"objective-approval-v1.schema.json#/$defs/namespace"},"minItems":1,"maxItems":1},
        "payload": {"$ref":"objective-approval-v1.schema.json#/$defs/fixtureApprovalCommandPayload"}
      }
    },
    {
      "required": ["command_type"],
      "properties": {
        "command_type": {
          "enum": [
            "entry",
            "publish_artifact",
            "publish_task_package",
            "migrate_legacy",
            "accept_task_result",
            "open_review_epoch",
            "open_review",
            "accept_review",
            "validate_findings",
            "terminal_review",
            "reopen_review",
            "accept_resolution_claim",
            "accept_finding_closure",
            "claim_task",
            "release_task",
            "invalidate_task",
            "replan_task",
            "open_epoch",
            "close_epoch",
            "close_group",
            "open_section",
            "open_group",
            "open_operational_group"
          ]
        }
      }
    },
    {
      "required": ["command_type","authority_ref","protected_fields","scope","payload"],
      "properties": {
        "command_type": {"const":"approve_objective"},
        "authority_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scopes",
            "run_id",
            "namespace",
            "approval_scope",
            "actor_id",
            "proposal_digest",
            "human_receipt",
            "protected_fields",
            "write_scopes",
            "project_root",
            "mode"
          ],
          "properties": {
            "status": {"const":"approved"},
            "scopes": {"type":"array","items":{"const":"approve_objective"},"minItems":1,"maxItems":1},
            "run_id": {"type":"string","minLength":1},
            "namespace": {"$ref":"objective-approval-v1.schema.json#/$defs/runtimeNamespace"},
            "approval_scope": {"const":"project-local"},
            "actor_id": {"type":"string","minLength":1},
            "proposal_digest": {"$ref":"objective-approval-v1.schema.json#/$defs/digest"},
            "human_receipt": {"$ref":"objective-approval-v1.schema.json#/$defs/runtimeReceipt"},
            "protected_fields": {"type":"array","items":{"const":"objective_ref"},"minItems":1,"maxItems":1},
            "write_scopes": {"type":"array","items":{"$ref":"objective-approval-v1.schema.json#/$defs/runtimeNamespace"},"minItems":1,"maxItems":1},
            "project_root": {"type":"string","pattern":"^/"},
            "mode": {"enum":["real","rehearsal"]}
          }
        },
        "protected_fields": {"type":"array","items":{"const":"objective_ref"},"minItems":1,"maxItems":1},
        "scope": {"type":"array","items":{"$ref":"objective-approval-v1.schema.json#/$defs/runtimeNamespace"},"minItems":1,"maxItems":1},
        "payload": {"$ref":"objective-approval-v1.schema.json#/$defs/runtimeApprovalCommandPayload"}
      }
    }
  ]
}
