{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a7-handoff-package-v1.schema.json",
  "title": "Immutable latest-manual-state package for A7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "workflow_version", "manual_state_revision", "manual_status", "manual_group_id", "manual_epoch_id", "manual_epoch_closed_at_revision", "checkpoint_id", "checkpoint_digest", "objective_ref", "aliases", "accepted_source_digest", "gates", "limitations", "rehearsal_receipt_digest", "rehearsal_migrated_head", "expected_kernel_head", "sources", "manifest_digest"],
  "properties": {
    "schema": {"const": "a7-handoff-package/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_version": {"type": "string", "minLength": 1},
    "manual_state_revision": {"type": "integer", "minimum": 1},
    "manual_status": {"type": "string", "minLength": 1},
    "manual_group_id": {"type": "string", "minLength": 1},
    "manual_epoch_id": {"type": "string", "minLength": 1},
    "manual_epoch_closed_at_revision": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "objective_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "digest", "approval_status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
        "approval_status": {"type": ["string", "null"]}
      }
    },
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "accepted_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"],
      "properties": {
        "G1": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}},
        "G2": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}},
        "G3": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}},
        "G4": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}},
        "G5": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}},
        "G6": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}},
        "G7": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}},
        "G8": {"type": "object", "required": ["status"], "properties": {"status": {"const": "pass"}}}
      }
    },
    "limitations": {"type": "array"},
    "rehearsal_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rehearsal_migrated_head": {"type": "object", "minProperties": 1},
    "expected_kernel_head": {"type": "object"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "checkpoint", "evidence", "approval", "rehearsal"],
      "properties": {
        "run": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "checkpoint": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "approval": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "rehearsal": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "objective": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
      }
    },
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
