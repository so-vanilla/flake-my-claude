{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-bundle/v1",
  "title": "Context Epoch or Group Artifact Bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "bundle_id",
    "version",
    "run_id",
    "workflow_version",
    "group_id",
    "context_epoch",
    "canonical_artifacts",
    "acceptance_evidence",
    "approved_decisions",
    "unresolved_items",
    "invalidated_artifacts",
    "next_inputs",
    "context_budget",
    "digest"
  ],
  "properties": {
    "schema": { "const": "artifact-bundle/v1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "workflow_version": { "type": "string", "minLength": 1 },
    "group_id": { "type": "string", "minLength": 1 },
    "context_epoch": {
      "type": "object",
      "required": ["id", "group_id", "boundary_reason", "clear_before_next"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "group_id": { "type": "string", "minLength": 1 },
        "boundary_reason": { "type": "string", "minLength": 1 },
        "clear_before_next": { "type": "boolean" }
      }
    },
    "canonical_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "version", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "acceptance_evidence": { "type": "array" },
    "approved_decisions": { "type": "array" },
    "unresolved_items": { "type": "array" },
    "invalidated_artifacts": { "type": "array" },
    "next_inputs": { "type": "array" },
    "context_budget": {
      "type": "object",
      "required": ["target", "normal_limit", "absolute_limit", "token_status", "token_count"],
      "properties": {
        "target": { "const": 200000 },
        "normal_limit": { "const": 300000 },
        "absolute_limit": { "const": 500000 },
        "token_status": { "enum": ["exact", "estimated", "unavailable"] },
        "token_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
