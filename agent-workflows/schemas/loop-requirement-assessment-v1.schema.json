{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-requirement-assessment-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirement_id", "status", "scope", "evidence_refs"],
  "properties": {
    "schema": {"const": "loop-requirement-assessment/v1"},
    "requirement_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "status": {"enum": ["pass", "fail", "unknown"]},
    "scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["digest"],
      "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}},
      "anyOf": [{"required": ["id"]}, {"required": ["path"]}]
    }
  }
}
