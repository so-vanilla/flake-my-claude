{
  "schema": "agent-workflow-owner-manifest/v1",
  "owner": "flake-my-claude.agent-workflows",
  "managed_sources": [
    "agent-workflows/src",
    "agent-workflows/schemas",
    "agent-workflows/scripts",
    "agent-workflows/skills",
    "agent-workflows/manifests"
  ],
  "managed_targets": [
    {"root": ".codex/skills", "content": "workflow-skill-directories", "mechanism": "programs.codex.skills"},
    {"root": ".claude/skills", "content": "workflow-skill-directories", "mechanism": "home.file"},
    {"root": ".agents/skills", "content": "workflow-skill-directories", "mechanism": "home.file"},
    {"root": ".local/share/agent-workflows", "content": "portable-manifests", "mechanism": "home.file"}
  ],
  "app_owned_exclusions": [
    ".codex/config.toml",
    ".codex/auth.json",
    ".codex/sessions",
    ".codex/plugins",
    ".codex/state"
  ],
  "cleanup_policy": "remove-only-previously-owned-targets-after-new-payload-verification"
}
